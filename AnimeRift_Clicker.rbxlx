		<Item class="ModuleScript" referent="RBX_RIFT_MODULE_IdleMotion"><Properties><string name="Name">IdleMotion</string><ProtectedString name="Source">-- Subtle procedural R6/R15 idle accents. Authored locomotion remains in control.
local I={}
local calm={gojo=true,beerus=true,awakened_aizen=true,aizen=true,byakuya=true,cid=true,ui_goku=true,kakashi=true,yuta=true,golden_experience_requiem=true}
local energetic={deku=true,kid_naruto=true,naruto=true,yuji=true,lee=true,denji=true,gear5_luffy=true,simon=true,gogeta=true,vegito=true}
local heavy={broly=true,boros=true,saitama=true,jotaro=true,dio=true,vegeta=true,madara=true,piccolo=true,asta=true,ssb_goku=true,ssj_goku=true}
function I.Profile(id)
 if calm[id] then return {Speed=.85,Breath=.025,Lean=.012} end
 if energetic[id] then return {Speed=1.65,Breath=.045,Lean=.024} end
 if heavy[id] then return {Speed=1.05,Breath=.025,Lean=.009} end
 return {Speed=1.15,Breath=.032,Lean=.016}
end
function I.Mount(character,id,run)
 local joints={};local h=character:FindFirstChildOfClass("Humanoid")
 for _,v in ipairs(character:GetDescendants()) do
  if v:IsA("Motor6D") and (v.Name=="Neck" or v.Name=="Right Shoulder" or v.Name=="Left Shoulder" or v.Name=="RightShoulder" or v.Name=="LeftShoulder") then table.insert(joints,{Joint=v,Base=v.C0}) end
 end
 local profile=I.Profile(id);local connection
 local function stop()
  if connection then connection:Disconnect();connection=nil end
  for _,entry in ipairs(joints) do if entry.Joint.Parent then entry.Joint.C0=entry.Base end end
 end
 connection=run.PreSimulation:Connect(function()
  if not character.Parent then stop();return end
  local idle=not h or (h.Health&gt;0 and h.MoveDirection.Magnitude&lt;.05 and h.FloorMaterial~=Enum.Material.Air and h.Sit==false)
  local t=os.clock()*profile.Speed
  for _,entry in ipairs(joints) do
   local joint=entry.Joint
   if joint.Parent then
    if not joint:GetAttribute("RiftPunch") then
     local neck=joint.Name=="Neck"
     joint.C0=entry.Base*(idle and CFrame.Angles(math.sin(t)*profile.Breath*(neck and .4 or 1),neck and math.sin(t*.6)*profile.Lean or 0,neck and 0 or math.sin(t*.8)*profile.Lean) or CFrame.new())
    end
   end
  end
 end)
 return stop
end
return I
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_RIFT_MODULE_TitleScreen"><Properties><string name="Name">TitleScreen</string><ProtectedString name="Source">-- Local, once-per-session welcome screen. No profile or currency mutations.
local T={}
local Tween=game:GetService("TweenService")
local Run=game:GetService("RunService")
local Input=game:GetService("UserInputService")
local Actions=game:GetService("ContextActionService")
local Gui=game:GetService("GuiService")
local function round(item,radius)
 local c=Instance.new("UICorner",item);c.CornerRadius=UDim.new(0,radius)
end
local function stroke(item,color,width)
 local s=Instance.new("UIStroke",item);s.Color=color;s.Thickness=width;s.ApplyStrokeMode=Enum.ApplyStrokeMode.Border
end
local function text(parent,value,x,y,w,h,size,color)
 local l=Instance.new("TextLabel",parent);l.Size=UDim2.fromOffset(w,h);l.Position=UDim2.fromOffset(x,y);l.BackgroundTransparency=1;l.Text=value;l.TextColor3=color or Color3.new(1,1,1);l.Font=Enum.Font.FredokaOne;l.TextSize=size;l.TextWrapped=true;l.TextStrokeTransparency=.12;return l
end
function T.Mount(ctx)
 if ctx.Player:GetAttribute("RiftTitleSeen") then ctx.OnPlay();return {IsOpen=function() return false end,Refresh=function() end} end
 local phase="Waiting"
 local started=os.clock()
 local connections={}
 local controls,disabledControls
 local cameraFov={}
 local ui=Instance.new("ScreenGui",ctx.Parent);ui.Name="AnimeRiftTitleScreen";ui.DisplayOrder=100;ui.ResetOnSpawn=false;ui.IgnoreGuiInset=true;ui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
 local backdrop=Instance.new("Frame",ui);backdrop.Name="TitleBackdrop";backdrop.Size=UDim2.fromScale(1,1);backdrop.BackgroundColor3=Color3.fromRGB(8,17,31);backdrop.BackgroundTransparency=.2;backdrop.Active=true
 local card=Instance.new("CanvasGroup",backdrop);card.Name="TitleCard";card.AnchorPoint=Vector2.new(.5,.5);card.Position=UDim2.fromScale(.5,.54);card.Size=UDim2.fromOffset(700,620);card.BackgroundColor3=Color3.fromRGB(26,32,36);round(card,20);stroke(card,Color3.fromRGB(5,8,12),4)
 local fit=Instance.new("UIScale",card)
 local header=Instance.new("Frame",card);header.Size=UDim2.fromOffset(700,142);header.BackgroundColor3=Color3.new(1,1,1);header.BorderSizePixel=0;round(header,20)
 local gradient=Instance.new("UIGradient",header);gradient.Rotation=90;gradient.Color=ColorSequence.new(Color3.fromRGB(255,187,52),Color3.fromRGB(230,93,7))
 for y=0,4 do for x=0,24 do if (x+y)%2==0 then
  local tile=Instance.new("Frame",header);tile.Size=UDim2.fromOffset(17,17);tile.Position=UDim2.fromOffset(10+x*28,6+y*28);tile.BackgroundColor3=Color3.new(1,1,1);tile.BackgroundTransparency=.84;tile.BorderSizePixel=0;round(tile,3)
 end end end
 text(header,"ANIME RIFT",20,15,660,68,58)
 text(header,"C L I C K E R",20,84,660,42,27)
 text(card,"WELCOME TO RIFT MEADOWS",25,166,650,36,26,Color3.fromRGB(112,237,255))
 text(card,"Collect your favorites. Build your power.",25,206,650,30,21)
 local steps={{"01","CLICK","Build your power"},{"02","SELL &amp; SUMMON","Collect stronger fighters"},{"03","REBIRTH","Grow your permanent bonus"}}
 for i,step in ipairs(steps) do
  local f=Instance.new("Frame",card);f.Size=UDim2.fromOffset(208,122);f.Position=UDim2.fromOffset(26+(i-1)*220,254);f.BackgroundColor3=Color3.fromRGB(42,51,58);round(f,12);stroke(f,Color3.fromRGB(76,91,104),1.5)
  text(f,step[1],5,4,198,32,24,Color3.fromRGB(255,207,77))
  text(f,step[2],5,39,198,28,21)
  text(f,step[3],12,75,184,37,17,Color3.fromRGB(207,219,230))
 end
 local play=Instance.new("TextButton",card);play.Name="TitlePlayButton";play.Size=UDim2.fromOffset(420,68);play.Position=UDim2.fromOffset(140,406);play.BackgroundColor3=Color3.new(1,1,1);play.AutoButtonColor=false;play.Text="";play.Modal=true;play.Selectable=true;round(play,16);stroke(play,Color3.fromRGB(3,8,10),4)
 local buttonGradient=Instance.new("UIGradient",play);buttonGradient.Rotation=90
 local playLabel=text(play,"LOADING...",8,4,404,60,34);playLabel.Name="Label"
 local buttonScale=Instance.new("UIScale",play)
 local previousSelection=Gui.SelectedObject
 if Input.GamepadEnabled then Gui.SelectedObject=play end
 local status=text(card,"Getting your inventory ready...",30,488,640,44,19,Color3.fromRGB(206,218,228));status.Name="TitleStatus"
 text(card,"Mouse / touch to play  •  Enter / A to start",25,553,650,32,17,Color3.fromRGB(155,174,192))
 if ctx.FighterCount then text(card,ctx.FighterCount.." FIGHTERS • 7 RARITIES",25,589,650,22,14,Color3.fromRGB(136,157,177)) end
 local function cameraView()
  local camera=workspace.CurrentCamera;if not camera then return end
  if cameraFov[camera]==nil then cameraFov[camera]=camera.FieldOfView or 70 end
  camera.CameraType=Enum.CameraType.Scriptable;camera.FieldOfView=64
  local t=(os.clock()-started)*.09
  camera.CFrame=CFrame.lookAt(Vector3.new(49+math.sin(t)*10,29,79+math.cos(t)*7),Vector3.new(0,6,-36))
 end
 local function resize()
  local camera=workspace.CurrentCamera;if not camera then return end
  fit.Scale=math.max(.01,math.min((camera.ViewportSize.X-28)/700,(camera.ViewportSize.Y-54)/620,1.1))
 end
 local function cleanUp()
  for _,connection in ipairs(connections) do connection:Disconnect() end
  table.clear(connections)
  ui:Destroy();phase="Closed"
 end
 local controller={}
 local lastStatus
 function controller:IsOpen() return phase~="Closed" end
 function controller:Refresh()
  if phase=="Closing" or phase=="Closed" then return end
  local ready=ctx.IsReady()
  local errorState=ctx.ServerStatus()=="Error"
  local retry=not ready and (errorState or os.clock()-started&gt;=12)
  local statusKey=ready and "Ready" or errorState and "Error" or retry and "Slow" or "Loading"
  if statusKey==lastStatus then return end;lastStatus=statusKey
  playLabel.Text=ready and "PLAY" or retry and "RETRY CONNECTION" or "LOADING..."
  buttonGradient.Color=ready and ColorSequence.new(Color3.fromRGB(182,255,63),Color3.fromRGB(61,194,26)) or ColorSequence.new(Color3.fromRGB(117,139,158),Color3.fromRGB(65,85,105))
  status.Text=ready and "Your fighters are ready. Let's get clicking!" or errorState and "The server could not start. Retry or rejoin to reconnect." or retry and "Still connecting. Select Retry to check again." or "Getting your inventory ready..."
 end
 local function begin()
  if phase~="Waiting" then return end
  if not ctx.IsReady() then
   if ctx.ServerStatus()=="Error" or os.clock()-started&gt;=12 then ctx.OnRetry() end
   controller:Refresh();return
  end
  phase="Closing";ctx.Player:SetAttribute("RiftTitleSeen",true)
  Actions:UnbindAction("RiftJoinTitle")
  if Gui.SelectedObject==play then Gui.SelectedObject=previousSelection and previousSelection.Parent and previousSelection or nil end
  if disabledControls and controls then controls:Enable();disabledControls=false end
  for camera,fov in pairs(cameraFov) do camera.FieldOfView=fov end
  local camera=workspace.CurrentCamera
  if camera then
   camera.CameraType=Enum.CameraType.Custom
   local character=ctx.Player.Character;local humanoid=character and character:FindFirstChildOfClass("Humanoid")
   if humanoid then camera.CameraSubject=humanoid end
  end
  ctx.OnPlay()
  Tween:Create(card,TweenInfo.new(.35,Enum.EasingStyle.Quad),{GroupTransparency=1,Position=UDim2.fromScale(.5,.53)}):Play()
  Tween:Create(backdrop,TweenInfo.new(.4),{BackgroundTransparency=1}):Play()
  task.delay(.42,cleanUp)
 end
 play.Activated:Connect(begin)
 play.MouseEnter:Connect(function() Tween:Create(buttonScale,TweenInfo.new(.14),{Scale=1.025}):Play() end)
 play.MouseLeave:Connect(function() Tween:Create(buttonScale,TweenInfo.new(.14),{Scale=1}):Play() end)
 table.insert(connections,Input.InputBegan:Connect(function(input,processed)
  if not processed and (input.KeyCode==Enum.KeyCode.Return or input.KeyCode==Enum.KeyCode.ButtonA) then begin() end
 end))
 Actions:BindActionAtPriority("RiftJoinTitle",function() return Enum.ContextActionResult.Sink end,false,3000,Enum.PlayerActions.CharacterForward,Enum.PlayerActions.CharacterBackward,Enum.PlayerActions.CharacterLeft,Enum.PlayerActions.CharacterRight,Enum.PlayerActions.CharacterJump)
 task.spawn(function()
  local scripts=ctx.Player:WaitForChild("PlayerScripts",10);if not scripts then return end
  local module=scripts:WaitForChild("PlayerModule",10);if not module then return end
  local ok,result=pcall(function() return require(module):GetControls() end)
  if ok and result and phase=="Waiting" then controls=result;controls:Disable();disabledControls=true end
 end)
 local viewportConnection
 local function connectCamera()
  if viewportConnection then viewportConnection:Disconnect() end
  local camera=workspace.CurrentCamera
  if camera then viewportConnection=camera:GetPropertyChangedSignal("ViewportSize"):Connect(resize);table.insert(connections,viewportConnection) end
  resize();if phase=="Waiting" then cameraView() end
 end
 table.insert(connections,workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(connectCamera))
 table.insert(connections,Run.RenderStepped:Connect(function()
  if phase=="Waiting" then cameraView();controller:Refresh() end
 end))
 connectCamera();controller:Refresh()
 Tween:Create(card,TweenInfo.new(.45,Enum.EasingStyle.Back),{Position=UDim2.fromScale(.5,.5)}):Play()
 return controller
end
return T
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_RIFT_MODULE_BrolyPose"><Properties><string name="Name">BrolyPose</string><ProtectedString name="Source">-- Pose a bounded anchored viewport rig, keeping welded visual pieces with their limbs.
local P={}
function P.Bind(actor)
 local core={Torso=actor:FindFirstChild("Torso") or actor:FindFirstChild("Body"),Head=actor:FindFirstChild("Head")}
 for _,part in ipairs(actor:GetDescendants()) do
  if part:IsA("BasePart") then
   for _,side in ipairs({"Left","Right"}) do
    if part.Name==side.." Arm" then core[side.." Arm"]=part end
    if part.Name==side.." Leg" then core[side.." Leg"]=part end
   end
   if part.Name=="Arm" then core[part.CFrame.Position.X&lt;0 and "Left Arm" or "Right Arm"]=part end
   if part.Name=="Leg" then core[part.CFrame.Position.X&lt;0 and "Left Leg" or "Right Leg"]=part end
  end
 end
 if not core.Torso or not core.Head then return function() end end
 local bases,groups,parts={},{},{}
 for name,part in pairs(core) do bases[name]=part.CFrame;groups[part]=name end
 local all=actor:GetDescendants()
 for _=1,3 do for _,joint in ipairs(all) do
  if (joint:IsA("WeldConstraint") or joint:IsA("Weld")) and joint.Part0 and joint.Part1 then
   if groups[joint.Part0] and not groups[joint.Part1] then groups[joint.Part1]=groups[joint.Part0] end
  end
 end end
 for _,part in ipairs(all) do if part:IsA("BasePart") then
  local group=groups[part]
  if not group then
   local distance=math.huge
   for name,base in pairs(bases) do local d=(base.Position-part.CFrame.Position).Magnitude;if d&lt;distance then distance=d;group=name end end
  end
  table.insert(parts,{Part=part,Group=group,Offset=bases[group]:ToObjectSpace(part.CFrame)})
 end end
 return function(sample)
  local torso=bases.Torso*CFrame.new(0,sample.RootY,0)*CFrame.Angles(sample.Lean,0,0)
  local posed={Torso=torso,Head=torso*bases.Torso:ToObjectSpace(bases.Head)*CFrame.Angles(sample.Head,0,0)}
  for _,side in ipairs({-1,1}) do
   local name=side&lt;0 and "Left" or "Right"
   local arm=core[name.." Arm"];local leg=core[name.." Leg"]
   if arm then
    local shoulderY=core.Torso.Size.Y/2-.2
    posed[name.." Arm"]=torso*CFrame.new(side*core.Torso.Size.X/2,shoulderY,0)*CFrame.Angles(-sample.Arm,0,side*sample.Spread)*CFrame.new(side*arm.Size.X/2,-shoulderY,0)
   end
   if leg then posed[name.." Leg"]=torso*CFrame.new(side*core.Torso.Size.X/4,-core.Torso.Size.Y/2,0)*CFrame.Angles(sample.Leg,0,side*sample.Energy*.08)*CFrame.new(0,-leg.Size.Y/2,0) end
  end
  for _,entry in ipairs(parts) do if entry.Part.Parent then entry.Part.CFrame=(posed[entry.Group] or torso)*entry.Offset end end
 end
end
return P
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_RIFT_MODULE_BrolySequence"><Properties><string name="Name">BrolySequence</string><ProtectedString name="Source">-- Reconstructed Legendary Rage presentation; viewport-only, one actor and fixed FX pools.
local B={}
local Run=game:GetService("RunService")
local Input=game:GetService("UserInputService")
local Actions=game:GetService("ContextActionService")
local Timeline=require(script.Parent:WaitForChild("BrolyTimeline"))
local Pose=require(script.Parent:WaitForChild("BrolyPose"))
B.Budget={MaxFX=96,FPS=30,ReducedFPS=24}
local active
local warmed={}
function B.Preload(soundId)
 if not soundId or soundId=="" or warmed[soundId] then return end
 warmed[soundId]=true
 task.spawn(function()
  local ok=pcall(function() game:GetService("ContentProvider"):PreloadAsync({soundId}) end)
  if not ok then warn("Broly skill audio preload failed; verify experience audio permissions in Studio.") end
 end)
end
function B.Play(ctx)
 if active then active:Cancel("Replaced") end
 local clock=ctx.Clock or os.clock;local start=clock();local done=false
 local connections={};local ui;local audio;local count=0
 local controls,disabledControls
 local reduced=Input.TouchEnabled==true or ctx.ReducedEffects==true
 local controller={Metrics={FX=0,FPS=reduced and 24 or 30,Duration=Timeline.Duration}}
 local function make(class,parent)
  assert(count&lt;B.Budget.MaxFX,"Broly FX budget exceeded")
  local item=Instance.new(class);item.Parent=parent;count+=1;controller.Metrics.FX=count;return item
 end
 local function finish(reason,destroying)
  if done then return end;done=true
  for _,connection in ipairs(connections) do connection:Disconnect() end
  if audio then audio:Destroy() end
  Actions:UnbindAction("RiftBrolySequence")
  if disabledControls and controls then controls:Enable();disabledControls=false end
  if ui and not destroying then ui:Destroy() end
  if active==controller then active=nil end
  if ctx.OnComplete then local ok,err=pcall(ctx.OnComplete,reason);if not ok then warn(tostring(err)) end end
 end
 function controller:Cancel(reason) finish(reason or "Skipped") end
 function controller:IsPlaying() return not done end
 active=controller
 local ok,err=xpcall(function()
  ui=make("ScreenGui",ctx.Parent);ui.Name="BrolyRageSequence";ui.IgnoreGuiInset=true;ui.ResetOnSpawn=false;ui.DisplayOrder=80
  local root=make("CanvasGroup",ui);root.Size=UDim2.fromScale(1,1);root.BackgroundColor3=Color3.new(1,1,1);root.BackgroundTransparency=1;root.Active=true
  local bg=make("Frame",root);bg.Size=UDim2.fromScale(1,1);bg.BackgroundColor3=Color3.fromRGB(43,92,67);bg.BorderSizePixel=0
  local gradient=make("UIGradient",bg);gradient.Color=ColorSequence.new(Color3.fromRGB(38,73,72),Color3.fromRGB(80,132,90));gradient.Rotation=90
  local view=ctx.Portrait(root,"broly",UDim2.new(),UDim2.fromScale(1,1),"Skill")
  assert(view and view.CurrentCamera,"Missing Broly preview")
  view.ZIndex=2;view.LightColor=Color3.new(1,1,1);view.Ambient=Color3.fromRGB(218,231,221);view.LightDirection=Vector3.new(-1,-1,-1)
  local world=view:FindFirstChildOfClass("WorldModel");local actor=world and world:FindFirstChildOfClass("Model");assert(actor,"Missing Broly actor")
  local pose=Pose.Bind(actor)
  local fx=make("Model",world);fx.Name="LegendaryRageFX"
  local green=Color3.fromRGB(104,255,49);local yellow=Color3.fromRGB(235,255,119)
  local function part(name,size,tint,material)
   local p=make("Part",fx);p.Name=name;p.Size=size;p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.Color=tint;p.Material=material or Enum.Material.Neon;p.Transparency=1;return p
  end
  local ground=part("Rage stage",Vector3.new(65,.4,65),Color3.fromRGB(82,97,91),Enum.Material.Slate);ground.CFrame=CFrame.new(0,-3.3,0);ground.Transparency=0
  local moon=part("Orbit moon",Vector3.new(20,20,2),Color3.fromRGB(232,255,245));moon.Shape=Enum.PartType.Ball
  local bubble=part("Energy sphere",Vector3.one,green);bubble.Shape=Enum.PartType.Ball
  local pillars,rocks,bolts,rings,sparks={},{},{},{},{}
  for i=1,(reduced and 4 or 7) do table.insert(pillars,part("Green energy pillar",Vector3.one,i%2==0 and yellow or green)) end
  for i=1,(reduced and 5 or 10) do table.insert(rocks,part("Floating debris",Vector3.one,Color3.fromRGB(52,66,55),Enum.Material.Slate)) end
  for i=1,(reduced and 4 or 8) do table.insert(bolts,part("Rage lightning",Vector3.new(.08,3,.08),yellow)) end
  for ring=1,(reduced and 1 or 2) do
   local segments={}
   for i=1,12 do table.insert(segments,part("Cyclone ring",Vector3.one,ring==1 and green or yellow)) end
   table.insert(rings,segments)
  end
  for i=1,(reduced and 8 or 14) do table.insert(sparks,part("Aura spark",Vector3.new(.12,.12,.12),Color3.fromRGB(217,255,206))) end
  local function text(value,size,y)
   local label=make("TextLabel",root);label.Position=UDim2.new(0,15,0,y);label.Size=UDim2.new(1,-30,0,35);label.BackgroundTransparency=1;label.Font=Enum.Font.FredokaOne;label.TextSize=size;label.TextColor3=Color3.new(1,1,1);label.TextStrokeTransparency=.1;label.Text=value;label.ZIndex=5;return label
  end
  text("LEGENDARY RAGE",25,18)
  local phase=text("",17,56)
  local skip=make("TextButton",root);skip.Name="SkipBrolySkill";skip.AnchorPoint=Vector2.new(1,1);skip.Position=UDim2.new(1,-20,1,-18);skip.Size=UDim2.fromOffset(230,42);skip.BackgroundColor3=Color3.fromRGB(26,45,36);skip.TextColor3=Color3.new(1,1,1);skip.Font=Enum.Font.GothamBold;skip.TextSize=14;skip.Text="SKIP VISUALS [SPACE/B]";skip.Modal=true;skip.Selectable=true;skip.ZIndex=6
  local hint=text(ctx.Preview and "PREVIEW ONLY • NO BOOST" or "Power charges on the server even if visuals are skipped",15,94)
  Actions:BindActionAtPriority("RiftBrolySequence",function() return Enum.ContextActionResult.Sink end,false,3000,Enum.PlayerActions.CharacterForward,Enum.PlayerActions.CharacterBackward,Enum.PlayerActions.CharacterLeft,Enum.PlayerActions.CharacterRight,Enum.PlayerActions.CharacterJump)
  if ctx.Player then task.spawn(function()
   local got,result=pcall(function()
    local scripts=ctx.Player:WaitForChild("PlayerScripts",10);local module=scripts and scripts:WaitForChild("PlayerModule",10)
    return module and require(module):GetControls()
   end)
   if got and result and not done then controls=result;controls:Disable();disabledControls=true end
  end) end
  local soundId=ctx.SoundId or ""
  if soundId~="" then
   audio=Instance.new("Sound");audio.Name="BrolyLegendaryRageAudio";audio.PlayOnRemove=false;audio.SoundId=soundId;audio.Volume=.55;audio.Looped=false;audio.Parent=game:GetService("SoundService");audio:Play()
  end
  table.insert(connections,skip.Activated:Connect(function() finish("Skipped") end))
  table.insert(connections,Input.InputBegan:Connect(function(input,processed) if not processed and (input.KeyCode==Enum.KeyCode.Space or input.KeyCode==Enum.KeyCode.ButtonB) then finish("Skipped") end end))
  table.insert(connections,ui.Destroying:Connect(function() finish("Closed",true) end))
  local humanoid=ctx.Character and ctx.Character:FindFirstChildOfClass("Humanoid")
  if humanoid then table.insert(connections,humanoid.Died:Connect(function() finish("Died") end)) end
  local last=-math.huge
  local function update(now)
   local t=math.max(0,now-start)
   if t&gt;=Timeline.Duration then finish("Completed");return end
   local s=Timeline.Sample(t);pose(s)
   phase.Text=s.Phase;hint.Text=ctx.Preview and "PREVIEW ONLY • NO BOOST" or string.format("POWER CHARGING • %ds",math.ceil(Timeline.Duration-t))
   local camera=s.Camera
   view.CurrentCamera.CFrame=CFrame.lookAt(Vector3.new(camera.X,camera.Y+s.RootY*.5,camera.Z),Vector3.new(camera.TX,camera.TY+s.RootY*.5,camera.TZ));view.CurrentCamera.FieldOfView=camera.FOV
   local energy=s.Energy
   ground.Transparency=s.Moon*.98
   local dx,dy,dz=camera.TX-camera.X,camera.TY-camera.Y,camera.TZ-camera.Z
   local length=math.max(.1,math.sqrt(dx*dx+dy*dy+dz*dz))
   moon.CFrame=CFrame.lookAt(Vector3.new(camera.TX+dx/length*9,camera.TY+s.RootY*.5+dy/length*9,camera.TZ+dz/length*9),Vector3.new(camera.X,camera.Y+s.RootY*.5,camera.Z));moon.Transparency=1-s.Moon*.9
   local sphereSize=5+energy*14
   bubble.Size=Vector3.new(sphereSize,sphereSize,sphereSize);bubble.CFrame=CFrame.new(0,s.RootY,0);bubble.Transparency=.98-energy*.12
   for i,p in ipairs(pillars) do
    local angle=i/#pillars*math.pi*2+t*.28
    local radius=1.9+i%3*.7;local height=5+s.Pillar*(17+i%3*4)
    p.Size=Vector3.new(.3+i%3*.3,height,.3+i%2*.4);p.CFrame=CFrame.new(math.cos(angle)*radius,height/2-3,math.sin(angle)*radius)*CFrame.Angles(0,angle,math.sin(t+i)*.08)
    p.Transparency=1-s.Pillar*(.22+i%2*.16)
   end
   for i,p in ipairs(rocks) do
    local angle=i/#rocks*math.pi*2+t*(.2+i%3*.09)
    local radius=3.5+i%3*1.4;local size=.4+i%3*.3
    p.Size=Vector3.new(size,size*.8,size);p.CFrame=CFrame.new(math.cos(angle)*radius,-2.6+energy*(2+i%4)+math.sin(t+i)*.2,math.sin(angle)*radius)*CFrame.Angles(t*.3+i,t*.2,i)
    p.Transparency=1-energy*.95
   end
   for i,p in ipairs(bolts) do
    local angle=i/#bolts*math.pi*2+math.floor(t*8)*.34
    p.CFrame=CFrame.new(math.cos(angle)*2,s.RootY+math.sin(t*4+i)*2,math.sin(angle)*2)*CFrame.Angles(.3*math.sin(t*9+i),0,math.sin(t*7+i)*.7)
    p.Transparency=1-energy*.8
   end
   for index,segments in ipairs(rings) do
    local radius=2.6+index*1.1+energy*.8
    for i,p in ipairs(segments) do
     local angle=(i-.5)/#segments*math.pi*2+s.Orbit*.8+index*.5
     p.Size=Vector3.new(.08,.08,2*radius*math.sin(math.pi/#segments)*1.05)
     p.CFrame=CFrame.new(math.cos(angle)*radius,s.RootY-1+index*1.2+math.sin(angle+t)*.25,math.sin(angle)*radius)*CFrame.Angles(0,-angle,0)
     p.Transparency=1-energy*.75
    end
   end
   for i,p in ipairs(sparks) do
    local angle=i*2.399+t*.3;local cycle=(t*.23+i/#sparks)%1;local radius=2+cycle*5
    p.CFrame=CFrame.new(math.cos(angle)*radius,cycle*11-3,math.sin(angle)*radius);p.Transparency=1-energy*(1-math.abs(cycle-.5))* .8
   end
   root.GroupTransparency=math.max(1-math.min(1,t/.22),math.max(0,(t-25.5)/.5))
  end
  table.insert(connections,Run.RenderStepped:Connect(function()
   if done then return end
   local now=clock();if now-last&lt;1/controller.Metrics.FPS then return end;last=now
   local frameOK,frameError=pcall(update,now);if not frameOK then warn("Broly sequence: "..tostring(frameError));finish("Error") end
  end))
  update(start)
 end,debug.traceback)
 if not ok then warn("Broly sequence setup: "..tostring(err));finish("Error") end
 return controller
end
return B
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_RIFT_MODULE_BrolyTimeline"><Properties><string name="Name">BrolyTimeline</string><ProtectedString name="Source">-- Legendary Rage: 26 seconds of local cinematic direction, with no engine services.
-- Pose order: RootY, Lean, Head, Arm, Spread, Leg, Energy, Pillar, Moon, Orbit.
-- Camera order: X, Y, Z, TX, TY, TZ, FOV. All rotations are radians.
local T={Duration=26}
local tau=math.pi*2
local keys={
 {0,"Confident",{0,0,.08,.06,.12,.04,.10,0,0,0},{.9,1.7,-2.2,0,1.5,0,43}},
 {1.2,"Confident",{0,0,.10,.08,.14,.04,.13,0,0,0},{1.05,1.7,-2.1,0,1.5,0,42}},
 {1.5,"SideTurn",{0,.04,.12,.12,.18,.05,.18,0,0,0},{2.6,1.9,-1.4,0,1.4,0,47}},
 {2.5,"LowBrace",{0,-.13,-.25,-.50,.30,.16,.36,0,0,0},{1.3,.25,-4,0,1,0,55}},
 {3.5,"ExplosiveFlare",{0,-.24,-.38,-.85,.42,.24,.76,.12,0,0},{4,2.5,-7,0,1.2,0,63}},
 {3.8,"ExplosiveFlare",{.25,-.28,.38,-.95,.52,.27,1,.58,0,0},{9,7,-16,0,2,0,77}},
 {5.5,"BowedFocus",{.08,-.12,-.65,-.60,.24,.15,.52,.08,0,0},{.8,1.5,-2.1,0,1.5,0,43}},
 {7,"SphereBuildup",{0,-.08,-.38,-.72,.34,.18,.58,.06,0,0},{9,7,-16,0,2,0,64}},
 {8.7,"SphereBuildup",{.12,-.06,-.20,-.85,.48,.22,.92,.18,0,0},{10,7.5,-18,0,2,0,69}},
 {10,"TorsoClose",{.15,-.08,-.28,-.85,.36,.18,.74,.08,0,0},{.6,.7,-2.8,0,.6,0,46}},
 {11.3,"FistClose",{.18,-.12,-.15,-1.28,.18,.20,.86,.18,0,0},{2,0,-1.7,.9,-.2,0,43}},
 {12.5,"PillarAscent",{.4,-.04,.15,-.65,.70,.24,.84,.48,0,0},{12,10,-26,0,4,0,72}},
 {12.8,"PillarAscent",{1.2,0,.42,-.42,.95,.26,1,1,.08,0},{12,10,-26,0,4,0,78}},
 {15,"MoonOrbit",{2,.02,.20,-.08,1.35,.12,.76,.60,.30,0},{9,7,-16,0,2,0,65}},
 {16.2,"MoonOrbit",{2,.03,.12,-.04,1.43,.10,.86,.42,.68,.90},{-6,5,-5,0,2,0,63}},
 {17.5,"MoonOrbit",{2,0,.05,-.10,1.50,.12,1,.30,1,3.1},{0,13,-.2,0,2,0,69}},
 {18.8,"MoonOrbit",{2,-.02,-.08,-.28,1.12,.14,.84,.25,.82,5.3},{-6,5,-5,0,2,0,62}},
 {19.5,"Cyclone",{2,-.08,-.20,-.62,.72,.16,.78,.20,.45,tau},{1,.9,-3.5,0,1.1,0,49}},
 {21,"Cyclone",{1.9,-.15,-.30,-.90,.60,.18,.86,.24,.28,tau},{-1.6,1.3,-4.2,0,1,0,54}},
 {22.5,"Settling",{1.5,-.06,-.10,-.30,.40,.14,.56,.10,.12,tau},{5,4,-9,0,1.5,0,59}},
 {24,"Landing",{0,-.18,-.25,-.45,.25,.30,.30,0,0,tau},{7,3,-14,0,.8,0,61}},
 {26,"Landing",{0,0,.02,.03,.10,.04,.10,0,0,tau},{7,3,-14,0,1,0,60}},
}
local poseFields={"RootY","Lean","Head","Arm","Spread","Leg","Energy","Pillar","Moon","Orbit"}
local cameraFields={"X","Y","Z","TX","TY","TZ","FOV"}
function T.Sample(time)
 local t=tonumber(time) or 0
 if t~=t then t=0 end
 t=math.clamp(t,0,T.Duration)
 local index=1
 while index&lt;#keys and keys[index+1][1]&lt;=t do index+=1 end
 local a,b=keys[index],keys[math.min(index+1,#keys)]
 local alpha=b[1]&gt;a[1] and (t-a[1])/(b[1]-a[1]) or 0
 alpha=alpha*alpha*(3-2*alpha)
 local result={Phase=a[2],Camera={}}
 for i,field in ipairs(poseFields) do result[field]=a[3][i]+(b[3][i]-a[3][i])*alpha end
 for i,field in ipairs(cameraFields) do result.Camera[field]=a[4][i]+(b[4][i]-a[4][i])*alpha end
 return result
end
return T
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_RIFT_MODULE_Polish"><Properties><string name="Name">Polish</string><ProtectedString name="Source">-- Cosmetic client effects only. No currency, damage, or inventory changes here.
local P={}
local Run=game:GetService("RunService")
local Tween=game:GetService("TweenService")
local Debris=game:GetService("Debris")
local C=require(script.Parent.Config)
local Idle=require(script.Parent.IdleMotion)
local idleStops={}
local function bindIdle(character)
 if not character:IsA("Model") then return end
 local function update()
  if idleStops[character] then idleStops[character]();idleStops[character]=nil end
  local id=character:GetAttribute("RiftIdleId")
  if id then idleStops[character]=Idle.Mount(character,id,Run) end
 end
 character:GetAttributeChangedSignal("RiftIdleId"):Connect(update)
 character.Destroying:Once(function() if idleStops[character] then idleStops[character]();idleStops[character]=nil end end)
 update()
end
for _,player in ipairs(game:GetService("Players"):GetPlayers()) do
 player.CharacterAdded:Connect(function(character) task.defer(bindIdle,character) end)
 if player.Character then bindIdle(player.Character) end
end
game:GetService("Players").PlayerAdded:Connect(function(player) player.CharacterAdded:Connect(function(character) task.defer(bindIdle,character) end) end)
local last=0
local pulses={}
local floating={}
local function watch(item)
 if item:IsA("BasePart") and item:GetAttribute("RiftFloat") then floating[item]=item.CFrame end
end
for _,item in ipairs(workspace:GetDescendants()) do watch(item) end
workspace.DescendantAdded:Connect(function(item) task.defer(watch,item) end)
Run.RenderStepped:Connect(function()
 local now=os.clock()
 for item,base in pairs(floating) do
  if item.Parent then item.CFrame=base*CFrame.new(0,math.sin(now*1.8+base.X)*.45,0)*CFrame.Angles(0,now*.4,0) else floating[item]=nil end
 end
end)
-- Sparse local fireflies keep the open plaza lively without replicated particle spam.
local function ambience(world)
 if world.Name~="RiftWorld" or world:FindFirstChild("LocalFireflies") then return end
 local anchor=Instance.new("Part");anchor.Name="LocalFireflies";anchor.Size=Vector3.new(195,12,175);anchor.Position=Vector3.new(0,7,0);anchor.Anchored=true;anchor.CanCollide=false;anchor.CanTouch=false;anchor.CanQuery=false;anchor.Transparency=1;anchor.Parent=world
 local motes=Instance.new("ParticleEmitter",anchor);motes.Texture="rbxasset://textures/particles/sparkles_main.dds";motes.Rate=10;motes.Lifetime=NumberRange.new(3,5);motes.Speed=NumberRange.new(.1,.4);motes.SpreadAngle=Vector2.new(180,180);motes.Shape=Enum.ParticleEmitterShape.Box;motes.ShapeStyle=Enum.ParticleEmitterShapeStyle.Volume;motes.LightEmission=1;motes.Color=ColorSequence.new(Color3.fromRGB(255,250,169));motes.Size=NumberSequence.new({NumberSequenceKeypoint.new(0,0),NumberSequenceKeypoint.new(.4,.2),NumberSequenceKeypoint.new(1,0)});motes.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(.25,.15),NumberSequenceKeypoint.new(1,1)})
end
workspace.ChildAdded:Connect(function(child) if child.Name=="RiftWorld" then task.defer(ambience,child) end end)
local current=workspace:FindFirstChild("RiftWorld");if current then ambience(current) end
local auraCharacter,auraId
function P.Aura(character,id)
 if not character then return end
 local root=character:FindFirstChild("HumanoidRootPart");if not root then return end
 if auraCharacter==character and auraId==id then return end
 auraCharacter=character;auraId=id
 local old=root:FindFirstChild("RiftLocalAura");if old then old:Destroy() end
 local aura=C.Find(C.Cosmetics,id);if not aura then return end
 local anchor=Instance.new("Attachment",root);anchor.Name="RiftLocalAura";anchor.Position=Vector3.new(0,-1,0)
 local particles=Instance.new("ParticleEmitter",anchor);particles.Texture="rbxasset://textures/particles/sparkles_main.dds";particles.Color=ColorSequence.new(aura.Color);particles.LightEmission=.8;particles.Rate=6+aura.Tier*2;particles.Lifetime=NumberRange.new(.5,1);particles.Speed=NumberRange.new(1,3);particles.SpreadAngle=Vector2.new(65,65);particles.Size=NumberSequence.new({NumberSequenceKeypoint.new(0,.15),NumberSequenceKeypoint.new(1,0)});particles.Transparency=NumberSequence.new(.3)
end
function P.Pulse(amount)
 -- A short tint pulse avoids camera drift, motion sickness, and stacked FOV tweens.
 local effect=Instance.new("ColorCorrectionEffect",game:GetService("Lighting"));effect.Name="RiftImpact";effect.Brightness=amount*.25;effect.TintColor=Color3.fromRGB(239,230,255)
 Tween:Create(effect,TweenInfo.new(.25),{Brightness=0,TintColor=Color3.new(1,1,1)}):Play();Debris:AddItem(effect,.3)
end
function P.Train(character,id)
 if not character or os.clock()-last&lt;.15 then return end;last=os.clock()
 local root=character:FindFirstChild("HumanoidRootPart");if not root then return end
 local hero=C.Find(C.Characters,id) or C.Characters[1]
 local ring=Instance.new("Part");ring.Name="LocalTrainingRipple";ring.Shape=Enum.PartType.Cylinder;ring.Anchored=true;ring.CanCollide=false;ring.CanTouch=false;ring.CanQuery=false;ring.Material=Enum.Material.Neon;ring.Color=hero.Color;ring.Transparency=.4;ring.Size=Vector3.new(.06,1.5,1.5);ring.CFrame=CFrame.new(root.Position-Vector3.new(0,2.6,0))*CFrame.Angles(0,0,math.pi/2);ring.Parent=workspace
 Tween:Create(ring,TweenInfo.new(.38,Enum.EasingStyle.Quad),{Size=Vector3.new(.06,5,5),Transparency=1}):Play();Debris:AddItem(ring,.4)
 local hand=character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm") or root
 local anchor=Instance.new("Attachment",hand)
 local sparks=Instance.new("ParticleEmitter",anchor);sparks.Texture="rbxasset://textures/particles/sparkles_main.dds";sparks.Color=ColorSequence.new(hero.Color);sparks.LightEmission=1;sparks.Lifetime=NumberRange.new(.18,.35);sparks.Speed=NumberRange.new(3,7);sparks.SpreadAngle=Vector2.new(160,160);sparks.Rate=0;sparks.Size=NumberSequence.new({NumberSequenceKeypoint.new(0,.22),NumberSequenceKeypoint.new(1,0)});sparks:Emit(6);Debris:AddItem(anchor,.5)
 -- Tiny local shoulder punch; restores the exact base pose after each click.
 local joint=character:FindFirstChild("RightShoulder",true) or character:FindFirstChild("Right Shoulder",true)
 if joint and joint:IsA("Motor6D") and not pulses[joint] and not joint:GetAttribute("RiftCasting") then
  local base=joint.C0;pulses[joint]=base;joint:SetAttribute("RiftPunch",true)
  Tween:Create(joint,TweenInfo.new(.07),{C0=base*CFrame.Angles(math.rad(55),0,math.rad(-12))}):Play()
  task.delay(.08,function()
   if joint.Parent then Tween:Create(joint,TweenInfo.new(.1),{C0=base}):Play() end
   task.delay(.11,function() pulses[joint]=nil;if joint.Parent then joint:SetAttribute("RiftPunch",nil) end end)
  end)
 end
end
return P
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_RIFT_MODULE_ClientLayout"><Properties><string name="Name">ClientLayout</string><ProtectedString name="Source">local L={}
function L.Measure(width,height)
 width=math.max(1,width);height=math.max(1,height-50)
 local portrait=width/height&lt;.95
 local w,h=portrait and 760 or 1200,portrait and 1200 or 760
 local windowW,windowH=portrait and 740 or 900,portrait and 560 or 580
 return {Portrait=portrait,Width=w,Height=h,Scale=math.max(.01,math.min(width/w,height/h)),WindowWidth=windowW,WindowHeight=windowH,WindowX=portrait and (w-windowW)/2 or 280,WindowY=portrait and 270 or 85}
end
function L.Number(value)
 value=math.max(0,tonumber(value) or 0)
 for _,unit in ipairs({{1e12,"T"},{1e9,"B"},{1e6,"M"}}) do if value&gt;=unit[1] then return string.format("%.2f%s",value/unit[1],unit[2]) end end
 if value&gt;=1e4 then return string.format("%.1fK",value/1e3) end
 return tostring(math.floor(value))
end
return L
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_RIFT_MODULE_RigRepair"><Properties><string name="Name">RigRepair</string><ProtectedString name="Source">-- Repair canonical R6 rigs, or mount a visual model onto a stable R6 carrier.
local R={}
local names={"HumanoidRootPart","Torso","Head","Right Arm","Left Arm","Right Leg","Left Leg"}
local offsets={HumanoidRootPart={0,0,0},Torso={0,0,0},Head={0,1.5,0},["Right Arm"]={1.5,0,0},["Left Arm"]={-1.5,0,0},["Right Leg"]={.5,-2,0},["Left Leg"]={-.5,-2,0}}
local function clean(model)
 local descendants=model:GetDescendants()
 for index=#descendants,1,-1 do
  local v=descendants[index]
  if v:IsA("LuaSourceContainer") or v:IsA("JointInstance") or v:IsA("Constraint") or v:IsA("BodyMover") then v:Destroy() end
 end
end
local function motor(name,a,b,c0)
 local m=Instance.new("Motor6D");m.Name=name;m.Part0=a;m.Part1=b;m.C0=c0;m.C1=b.CFrame:ToObjectSpace(a.CFrame*c0);m.Parent=a
end
local function link(core)
 local quarter=CFrame.Angles(-math.pi/2,0,math.pi)
 motor("RootJoint",core.HumanoidRootPart,core.Torso,quarter)
 motor("Neck",core.Torso,core.Head,CFrame.new(0,1,0)*quarter)
 for _,side in ipairs({-1,1}) do
  local word=side==1 and "Right" or "Left"
  motor(word.." Shoulder",core.Torso,core[word.." Arm"],CFrame.new(side,.5,0)*CFrame.Angles(0,side*math.pi/2,0))
  motor(word.." Hip",core.Torso,core[word.." Leg"],CFrame.new(side,-1,0)*CFrame.Angles(0,side*math.pi/2,0))
 end
end
local function bodyGroup(part)
 local p=part
 while p and not p:IsA("Model") do
  local n=p.Name:lower():gsub("[%s_%-]","")
  if n=="head" then return "Head" end
  if n=="torso" or n=="uppertorso" or n=="lowertorso" then return "Torso" end
  for _,side in ipairs({"left","right"}) do
   local word=side=="left" and "Left" or "Right"
   if n==side.."arm" or n==side.."upperarm" or n==side.."lowerarm" or n==side.."hand" then return word.." Arm" end
   if n==side.."leg" or n==side.."upperleg" or n==side.."lowerleg" or n==side.."foot" then return word.." Leg" end
  end
  p=p.Parent
 end
end
local function weldExtras(model,core)
 local set={};for _,part in pairs(core) do set[part]=true end
 for _,part in ipairs(model:GetDescendants()) do
  if part:IsA("BasePart") and not set[part] then
   local host=core[bodyGroup(part)]
   if not host then
    local distance=math.huge
    for name,candidate in pairs(core) do
     if name~="HumanoidRootPart" then local d=(candidate.CFrame.Position-part.CFrame.Position).Magnitude;if d&lt;distance then distance=d;host=candidate end end
    end
   end
   part.Anchored=false;part.CanCollide=false;part.CanTouch=false;part.CanQuery=false;part.Massless=true
   local weld=Instance.new("WeldConstraint");weld.Parent=part;weld.Name="RiftSkinWeld";weld.Part0=host;weld.Part1=part
  end
 end
end
function R.Prepare(template)
 if not template or not template:IsA("Model") then return nil,"Expected a Model" end
 local original=template:Clone();clean(original)
 local core={};local canonical=true
 for _,name in ipairs(names) do
  local part=original:FindFirstChild(name)
  if part and part:IsA("BasePart") then core[name]=part else canonical=false end
 end
 local model=original
 if not canonical then
  local parts={};for _,p in ipairs(original:GetDescendants()) do if p:IsA("BasePart") and p.Name~="HumanoidRootPart" then table.insert(parts,p) end end
  if #parts==0 then original:Destroy();return nil,"Model has no visible body parts" end
  local descendants=original:GetDescendants()
  for index=#descendants,1,-1 do local v=descendants[index];if v:IsA("Humanoid") or v.Name=="HumanoidRootPart" then v:Destroy() end end
  -- Normalize oversized toolbox models while preserving their relative appearance.
  local _,size=original:GetBoundingBox()
  original:ScaleTo(original:GetScale()*6/math.max(size.Y,.1))
  local bounds=original:GetBoundingBox()
  original:PivotTo(CFrame.new(0,-.5,0)*bounds:Inverse()*original:GetPivot())
  model=Instance.new("Model");model.Name=template.Name;core={}
  for _,name in ipairs(names) do
   local p=Instance.new("Part");p.Name=name;local o=offsets[name];p.CFrame=CFrame.new(o[1],o[2],o[3]);p.Size=(name:find("Arm") or name:find("Leg")) and Vector3.new(1,2,1) or name=="Head" and Vector3.new(2,1,1) or Vector3.new(2,2,1);p.Transparency=1;p.Parent=model;core[name]=p
  end
  -- Classic clothing renders on the Humanoid's direct R6 body, not a nested visual model.
  local shirt,pants,graphic=false,false,false
  for _,item in ipairs(original:GetDescendants()) do
   if item:IsA("Shirt") then shirt=true;item.Parent=model
   elseif item:IsA("Pants") then pants=true;item.Parent=model
   elseif item:IsA("ShirtGraphic") then graphic=true;item.Parent=model
   elseif item:IsA("BodyColors") then item.Parent=model end
  end
  local clothed={Torso=shirt or pants or graphic,["Right Arm"]=shirt,["Left Arm"]=shirt,["Right Leg"]=pants,["Left Leg"]=pants}
  for _,part in ipairs(original:GetDescendants()) do
   if part:IsA("BasePart") then
    local group=bodyGroup(part)
    if group and clothed[group] then
     core[group].Transparency=0;core[group].Color=part.Color;part.Transparency=1
    end
   end
  end
  original.Name="RiftVisualSkin";original.Parent=model
 end
 local previousHumanoid=model:FindFirstChildOfClass("Humanoid");if previousHumanoid then previousHumanoid:Destroy() end
 local humanoid=Instance.new("Humanoid");humanoid.Parent=model;humanoid.RigType=Enum.HumanoidRigType.R6
 humanoid.HipHeight=0;humanoid.RequiresNeck=false;humanoid.BreakJointsOnDeath=false;humanoid.MaxHealth=100;humanoid.Health=100
 -- Remove the old Animator's cached tracks; the game supplies its R6 Animate script.
 local old=humanoid:FindFirstChildOfClass("Animator");if old then old:Destroy() end
 local animator=Instance.new("Animator");animator.Parent=humanoid
 for name,p in pairs(core) do
  p.Anchored=false;p.CanCollide=name=="Torso" or name=="Head";p.CanTouch=false;p.Massless=false
 end
 core.HumanoidRootPart.CanCollide=false;core.HumanoidRootPart.RootPriority=127
 link(core);weldExtras(model,core);humanoid.RequiresNeck=true
 model.PrimaryPart=core.HumanoidRootPart;model:SetAttribute("RiftRepaired",true)
 return model
end
return R
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_RIFT_MODULE_SummonPresets"><Properties><string name="Name">SummonPresets</string><ProtectedString name="Source">-- Data-only summon direction. Effects are local, short, and share a fixed budget.
local P={All={},Budget={MaxInstances=72,MaxParticles=36,MaxPreviewParts=64,MaxPreviewDescendants=256,FPS=30}}
local function add(id,title,motif,color,accent,count,turns,tilt,pulse,phase,seed,pose)
 P.All[id]={Title=title,Motif=motif,Color=color,Accent=accent,Count=count,Turns=turns,Tilt=tilt,Pulse=pulse,Phase=phase,Seed=seed,Pose=pose}
end
-- Mythic: one signature gesture and a restrained impact.
add("vegeta","Royal Blue Ascension","pillar",{42,130,255},{243,210,95},12,.65,.08,.07,.15,101,"ascend")
add("ichigo","Moonfang Crescent","slashes",{255,119,45},{60,33,84},10,.35,-.32,.08,.42,102,"strike")
add("sukuna","Crimson Dismantle","slashes",{238,49,72},{255,178,164},16,-.55,.23,.11,.74,103,"strike")
add("gojo","Limitless Convergence","orbit",{89,161,255},{213,124,255},12,1.2,.06,.055,1.05,104,"calm")
add("asta","Anti-Magic Edge","slashes",{108,62,151},{246,72,59},14,-.8,-.2,.095,1.37,105,"strike")
add("yuji","Black Flash Awakening","storm",{236,43,83},{255,206,184},10,.6,.19,.12,1.68,106,"strike")
add("deku","Emerald Full Cowling","storm",{50,237,153},{210,255,220},14,1.05,-.08,.085,1.99,107,"charge")
add("jotaro","Silent Star","clock",{148,95,247},{104,242,250},12,-.25,.04,.045,2.31,108,"calm")
add("dio","The Frozen Second","clock",{255,214,64},{109,240,124},16,.2,-.12,.065,2.62,109,"strike")
add("gogeta","Stardust Breaker","burst",{100,198,255},{255,161,88},18,1.4,.15,.09,2.93,110,"charge")
add("vegito","Spirit Sword Radiance","pillar",{66,233,255},{255,233,133},10,-.45,-.16,.07,3.24,111,"strike")
add("ssb_goku","Azure Kamehameha","pillar",{37,167,255},{220,252,255},14,.85,.02,.1,3.56,112,"charge")
-- Secret: a slightly longer reveal, still using the same small effect pool.
add("naruto","Sage Spiral","spiral",{255,153,49},{103,189,255},14,1.65,.18,.08,.27,113,"charge")
add("aizen","Mirror Sovereignty","clock",{182,131,250},{247,226,174},10,-.65,-.09,.045,.59,114,"calm")
add("ui_goku","Silver Stillness","orbit",{231,246,255},{103,193,255},12,-1.1,.035,.035,.91,115,"calm")
add("cid","Atomic Eclipse","sigil",{160,95,247},{239,195,255},16,-.9,.12,.12,1.22,116,"calm")
add("madara","Falling Heavens","sigil",{232,73,78},{255,173,84},18,.55,-.24,.1,1.54,117,"ascend")
add("gear5_luffy","Clouds of Liberation","spiral",{245,243,255},{255,224,106},12,.95,.28,.06,1.85,118,"ascend")
add("beerus","Destroyer's Violet Orbit","orbit",{174,91,239},{255,156,231},8,-1.45,-.05,.055,2.17,119,"calm")
add("boros","Meteoric Drive","storm",{246,96,213},{111,238,255},18,1.8,.21,.11,2.48,120,"charge")
add("saitama","Serious Horizon","burst",{250,92,66},{255,227,106},8,.15,0,.075,2.79,121,"strike")
add("golden_experience_requiem","Return to Zero","sigil",{255,212,79},{205,112,252},14,-1.25,.14,.06,3.11,122,"calm")
-- Super Secret: distinct silhouettes and color stories, never a larger object cap.
add("marlon","Rift Sovereign","sigil",{69,249,221},{255,217,112},18,1.75,-.19,.1,.38,123,"ascend")
add("awakened_aizen","Shattered Chrysalis","petals",{239,224,255},{181,110,247},16,-1.5,.24,.07,1.42,124,"ascend")
add("broly","Emerald Detonation","burst",{130,247,65},{236,255,188},18,.95,-.11,.13,2.46,125,"charge")
add("simon","Spiral Beyond Heaven","spiral",{60,224,255},{249,99,180},18,2.15,.31,.09,3.5,126,"ascend")
function P.Get(id) return P.All[id] end
function P.Duration(tier)
 if tier==5 then return 3.2 elseif tier==6 then return 3.8 elseif tier==7 then return 4.4 end
 return 0
end
return P
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_RIFT_MODULE_OutfitDetails"><Properties><string name="Name">OutfitDetails</string><ProtectedString name="Source">-- Small block-built accessories shared by live avatars and inventory previews.
local D={}
function D.Apply(character,outfit,parent,anchored)
 local head=character:FindFirstChild("Head")
 local torso=character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso") or character:FindFirstChild("Body")
 if not head then return end
 local unit=head.Size.X/2
 local function piece(name,host,size,offset,color,wedge)
  if not host then return end
  local p=Instance.new(wedge and "WedgePart" or "Part");p.Name=name;p.Size=Vector3.new(size[1]*unit,size[2]*unit,size[3]*unit);p.CFrame=host.CFrame*CFrame.new(offset[1]*unit,offset[2]*unit,offset[3]*unit);p.Color=Color3.fromRGB(table.unpack(color));p.Material=Enum.Material.SmoothPlastic;p.Anchored=anchored==true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.Massless=true;p.Parent=parent
  if not anchored then local weld=Instance.new("WeldConstraint",p);weld.Part0=host;weld.Part1=p end
 end
 if outfit.Hat then
  piece("Fighter cap",head,{2.15,.55,1.5},{0,.65,0},outfit.Hat)
  piece("Cap brim",head,{2.2,.12,1.1},{0,.45,-.8},outfit.Hat)
 end
 if outfit.Headband then piece("Headband",head,{2.05,.28,.12},{0,.25,-.56},outfit.Headband) end
 if outfit.Ears then for _,side in ipairs({-1,1}) do piece("Cat ear",head,{.5,1.5,.5},{side*.65,1,0},outfit.Ears,true) end end
 if outfit.Cape then piece("Fighter cape",torso,{2.3,2.8,.18},{0,-.35,.7},outfit.Cape) end
 if outfit.Collar then piece("Fighter collar",torso,{2.1,.35,1.1},{0,.85,0},outfit.Collar) end
 if outfit.Tie then piece("Fighter tie",torso,{.25,1.3,.12},{0,.1,-.56},outfit.Tie) end
end
return D
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_RIFT_MODULE_SummonCinematics"><Properties><string name="Name">SummonCinematics</string><ProtectedString name="Source">-- A single local viewport + a small reusable pool of GUI effects. No world-camera,
-- physics, remote requests, downloaded assets, or per-frame Instance allocation.
local Scenes={}
local Presets=require(script.Parent:WaitForChild("SummonPresets"))
local Run=game:GetService("RunService")
local Input=game:GetService("UserInputService")
Scenes.Budget=Presets.Budget
local active
local function color(rgb) return Color3.fromRGB(rgb[1],rgb[2],rgb[3]) end
local function ease(x) return 1-(1-math.clamp(x,0,1))^3 end
function Scenes.Play(item,ctx)
 local preset=Presets.Get(item.Id)
 if not preset or item.Tier&lt;5 then return nil end
 if active then active:Cancel("Replaced") end
 local clock=ctx.Clock or os.clock
 local started=clock()
 local duration=Presets.Duration(item.Tier)
 local reduced=ctx.ReducedEffects==true or Input.TouchEnabled==true
 local count=math.min(preset.Count,reduced and 10 or Presets.Budget.MaxParticles)
 local fps=reduced and 24 or Presets.Budget.FPS
 local connections={}
 local finished=false
 local impacted=false
 local ui,actor,view,base
 local made=0
 local controller={Metrics={Effects=0,Particles=count,FPS=fps,Duration=duration}}
 local function make(class,parent)
  assert(made&lt;Presets.Budget.MaxInstances,"Summon effect budget exceeded")
  local value=Instance.new(class);value.Parent=parent;made+=1;controller.Metrics.Effects=made;return value
 end
 local function finish(reason,alreadyDestroying)
  if finished then return end;finished=true
  for _,connection in ipairs(connections) do connection:Disconnect() end;table.clear(connections)
  if active==controller then active=nil end
  if ui and not alreadyDestroying then ui:Destroy() end
  if ctx.OnComplete then
   local ok,err=pcall(ctx.OnComplete,reason);if not ok then warn("Summon reveal callback: "..tostring(err)) end
  end
 end
 function controller:Cancel(reason) finish(reason or "Skipped") end
 function controller:IsPlaying() return not finished end
 active=controller
 local ok,err=xpcall(function()
  local primary,accent=color(preset.Color),color(preset.Accent)
  ui=make("ScreenGui",ctx.Parent);ui.Name="RiftSummonCutscene";ui.DisplayOrder=70;ui.IgnoreGuiInset=true;ui.ResetOnSpawn=false;ui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
  local root=make("CanvasGroup",ui);root.Size=UDim2.fromScale(1,1);root.BackgroundColor3=Color3.new(1,1,1);root.BackgroundTransparency=1;root.Active=true;root.GroupTransparency=0
  -- Keep the gradient off CanvasGroup: a group gradient tints the composited actor too.
  local background=make("Frame",root);background.Name="CinematicBackdrop";background.Size=UDim2.fromScale(1,1);background.BackgroundColor3=Color3.new(1,1,1);background.BorderSizePixel=0
  local gradient=make("UIGradient",background);gradient.Rotation=30+preset.Seed%120;gradient.Color=ColorSequence.new(primary:Lerp(Color3.fromRGB(95,130,171),.55),accent:Lerp(Color3.fromRGB(147,174,207),.65))
  local stage=make("Frame",root);stage.Name="CinematicStage";stage.Size=UDim2.fromOffset(720,620);stage.AnchorPoint=Vector2.new(.5,.5);stage.Position=UDim2.fromScale(.5,.5);stage.BackgroundTransparency=1;stage.ZIndex=2
  local fit=make("UIScale",stage)
  local function resize()
   local camera=workspace.CurrentCamera;if not camera then return end
   fit.Scale=math.max(.01,math.min((camera.ViewportSize.X-24)/720,(camera.ViewportSize.Y-40)/620,1.45))
  end
  local viewportConnection
  local function connectCamera()
   if viewportConnection then viewportConnection:Disconnect() end
   local camera=workspace.CurrentCamera
   if camera then viewportConnection=camera:GetPropertyChangedSignal("ViewportSize"):Connect(resize);table.insert(connections,viewportConnection) end
   resize()
  end
  local function frame(parent,w,h,x,y,tint,z)
   local f=make("Frame",parent);f.Size=UDim2.fromOffset(w,h);f.Position=UDim2.fromOffset(x,y);f.BackgroundColor3=tint;f.BorderSizePixel=0;f.ZIndex=z or 1;return f
  end
  local function label(value,y,size,tint)
   local l=make("TextLabel",stage);l.Size=UDim2.fromOffset(700,54);l.Position=UDim2.fromOffset(10,y);l.BackgroundTransparency=1;l.Font=Enum.Font.FredokaOne;l.Text=value;l.TextSize=size;l.TextColor3=tint;l.TextWrapped=true;l.TextStrokeTransparency=.2;l.ZIndex=6;return l
  end
  local top=frame(root,0,0,0,0,Color3.new(0,0,0),8);top.Size=UDim2.new(1,0,.045,0)
  local bottom=frame(root,0,0,0,0,Color3.new(0,0,0),8);bottom.Size=UDim2.new(1,0,.045,0);bottom.Position=UDim2.new(0,0,.955,0)
  label(({[5]="MYTHIC",[6]="SECRET",[7]="SUPER SECRET"})[item.Tier]..(ctx.Preview and " PREVIEW" or " SUMMON"),18,23,accent)
  local phrase=label(preset.Title,71,31,Color3.new(1,1,1))
  local name=label(item.Name,500,36,primary:Lerp(Color3.new(1,1,1),.5));name.TextTransparency=1
  local caption=label("A new power is awakening...",553,17,accent)
  local progress=frame(stage,420,3,150,605,Color3.fromRGB(45,53,66),6)
  local fill=frame(progress,0,3,0,0,accent,6)
  local skip=make("TextButton",root);skip.Name="SkipCutscene";skip.AnchorPoint=Vector2.new(1,1);skip.Position=UDim2.new(1,-24,1,-16);skip.Size=UDim2.fromOffset(180,42);skip.BackgroundColor3=Color3.fromRGB(21,26,37);skip.TextColor3=Color3.new(1,1,1);skip.Font=Enum.Font.GothamBold;skip.TextSize=15;skip.Text="SKIP  [SPACE / B]";skip.AutoButtonColor=true;skip.ZIndex=12;skip.Selectable=true;skip.Modal=true
  local corner=make("UICorner",skip);corner.CornerRadius=UDim.new(0,10)
  local wash=frame(stage,720,620,0,0,primary,1);wash.BackgroundTransparency=1
  -- Existing portrait construction supplies exactly one character clone, separately
  -- budgeted from the effect pool. It is never cloned or rebuilt during a frame.
  view=ctx.Portrait(stage,item.Id,UDim2.fromOffset(130,94),UDim2.fromOffset(460,420),"Cinematic")
  assert(view,"No character preview")
  local world=view:FindFirstChildOfClass("WorldModel")
  actor=world and world:FindFirstChildOfClass("Model");base=actor and actor:GetPivot()
  view.ZIndex=3;view.LightColor=Color3.new(1,1,1);view.Ambient=Color3.fromRGB(225,225,235);view.LightDirection=Vector3.new(-1,-1,-1)
  local rings={}
  for index=1,3 do
   local f=frame(stage,140+index*45,140+index*45,360,295,index%2==0 and accent or primary,2);f.AnchorPoint=Vector2.new(.5,.5);f.BackgroundTransparency=1;f.Rotation=index*25
   local radius=make("UICorner",f);radius.CornerRadius=UDim.new(.5,0)
   local line=make("UIStroke",f);line.Thickness=index==1 and 3 or 1.5;line.Color=index%2==0 and accent or primary;line.Transparency=.5
   table.insert(rings,{Frame=f,Line=line})
  end
  local particles={}
  for index=1,count do
   local f=frame(stage,6,15,360,295,index%3==0 and accent or primary,2)
   f.AnchorPoint=Vector2.new(.5,.5);f.BackgroundTransparency=.25
   if preset.Motif=="orbit" or preset.Motif=="petals" then local c=make("UICorner",f);c.CornerRadius=UDim.new(1,0) end
   table.insert(particles,f)
  end
  connectCamera()
  table.insert(connections,workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(connectCamera))
  table.insert(connections,skip.Activated:Connect(function() finish("Skipped") end))
  table.insert(connections,Input.InputBegan:Connect(function(input,processed)
   if not processed and (input.KeyCode==Enum.KeyCode.Space or input.KeyCode==Enum.KeyCode.ButtonB) then finish("Skipped") end
  end))
  table.insert(connections,ui.Destroying:Connect(function() finish("Closed",true) end))
  local last=-math.huge
  local function update(now)
   local elapsed=math.max(0,now-started);local p=math.clamp(elapsed/duration,0,1)
   if p&gt;=1 then finish("Completed");return end
   if not ui.Parent then finish("Closed");return end
   local enter=ease(p/.12);local exit=math.clamp((p-.89)/.11,0,1)
   local impact=math.max(0,1-math.abs(p-.55)/.12)
   root.GroupTransparency=math.max(1-enter,exit)
   wash.BackgroundTransparency=1-impact*(.03+preset.Pulse*.1) -- a tint accent, never a white flash
   phrase.TextTransparency=math.clamp((p-.68)/.18,0,1)
   name.TextTransparency=1-ease((p-.24)/.16)
   caption.Text=ctx.Preview and "Preview only • No rewards granted" or p&gt;.6 and "Already saved to your collection" or "A new power is awakening..."
   fill.Size=UDim2.fromOffset(420*p,3)
   if not impacted and p&gt;=.52 then impacted=true;if ctx.OnImpact then local soundOK,soundError=pcall(ctx.OnImpact);if not soundOK then warn(tostring(soundError)) end end end
   if view.CurrentCamera then view.CurrentCamera.FieldOfView=38-enter*5-impact*2+p*2 end
   if actor and actor.Parent and base then
    local yaw=math.sin(p*math.pi)*.22*preset.Turns
    local rise=preset.Pose=="ascend" and math.sin(p*math.pi)*.28 or preset.Pose=="charge" and -impact*.13 or math.sin(elapsed)*.035
    local lean=preset.Pose=="strike" and (impact-.2)*preset.Tilt or math.sin(p*math.pi)*preset.Tilt*.2
    actor:PivotTo(base*CFrame.new(preset.Pose=="strike" and impact*.13 or 0,rise,0)*CFrame.Angles(0,yaw,lean))
   end
   for index,entry in ipairs(rings) do
    local size=(145+index*45)*(enter+.2+impact*.25)
    entry.Frame.Size=UDim2.fromOffset(size,size);entry.Frame.Rotation=p*180*preset.Turns+index*24
    entry.Line.Transparency=math.clamp(.55-impact*.3+exit,0,1)
    -- Clock freezes, then reverses. Sigils retain angular ritual outlines.
    if preset.Motif=="clock" then entry.Frame.Rotation=(p&lt;.5 and p or .5-(p-.5)*2)*180*preset.Turns+index*30 end
    if preset.Motif=="sigil" then entry.Frame.Rotation=p*90*preset.Turns+index*45 end
   end
   for index,f in ipairs(particles) do
    local angle=index/count*math.pi*2+preset.Phase
    local phase=(p*1.8+index/count)%1
    local radius=65+enter*115+impact*45
    local x,y=math.cos(angle+p*preset.Turns*3)*radius,math.sin(angle+p*preset.Turns*3)*radius*.72
    local w,h,rotation=5,14,angle*180/math.pi
    if preset.Motif=="slashes" then
     x=(phase-.5)*600;y=math.sin(index*2+preset.Phase)*160;w=90+index%4*34;h=3+index%2;rotation=preset.Tilt*150+index%2*75
    elseif preset.Motif=="storm" then
     x=math.sin(index*2.7+p*14)*200;y=(phase-.5)*430;w=3;h=28+index%4*13;rotation=math.sin(index+p*10)*40
    elseif preset.Motif=="pillar" then
     x=math.sin(index*1.7+preset.Phase)*175;y=200-phase*410;w=3+index%3;h=42+index%3*28;rotation=preset.Tilt*20
    elseif preset.Motif=="burst" then
     radius=40+phase*240;x=math.cos(angle)*radius;y=math.sin(angle)*radius*.8;w=8;h=35+phase*80;rotation=angle*180/math.pi+90
    elseif preset.Motif=="petals" then
     x=math.cos(angle+p*3)*radius;y=(phase-.5)*390;w=9;h=17;rotation=p*360+index*25
    elseif preset.Motif=="clock" then
     local turn=p&lt;.5 and p or .5-(p-.5)*2
     x=math.cos(angle+turn*preset.Turns)*radius;y=math.sin(angle+turn*preset.Turns)*radius;w=4;h=index%3==0 and 23 or 12;rotation=angle*180/math.pi+turn*60
    elseif preset.Motif=="spiral" then
     radius=35+(1-phase)*220;x=math.cos(angle+p*preset.Turns*7)*radius;y=math.sin(angle+p*preset.Turns*7)*radius*.75;w=5;h=22;rotation=angle*180/math.pi+p*180
    elseif preset.Motif=="orbit" then
     radius=radius*(1-impact*.35);x=math.cos(angle+p*preset.Turns*4)*radius;y=math.sin(angle+p*preset.Turns*4)*radius*.7;w=index&lt;=2 and 23 or 7;h=w;rotation=0
    elseif preset.Motif=="sigil" then
     local segment=index%2==0 and 1 or .7;x=math.cos(angle+p*preset.Turns)*radius*segment;y=math.sin(angle+p*preset.Turns)*radius*segment;w=4;h=24;rotation=angle*180/math.pi+p*60
    end
    f.Position=UDim2.fromOffset(360+x,290+y);f.Size=UDim2.fromOffset(w,h);f.Rotation=rotation;f.BackgroundTransparency=math.clamp(.2+math.abs(phase-.5)*.8+exit,0,1)
   end
  end
  table.insert(connections,Run.RenderStepped:Connect(function()
   if finished then return end
   local now=clock();if now-last&lt;1/fps then return end;last=now
   local frameOK,frameError=pcall(update,now)
   if not frameOK then warn("Summon cutscene: "..tostring(frameError));finish("Error") end
  end))
  update(started)
 end,debug.traceback)
 if not ok then warn("Summon cutscene setup: "..tostring(err));finish("Error") end
 return controller
end
return Scenes
</ProtectedString></Properties></Item></Item>
