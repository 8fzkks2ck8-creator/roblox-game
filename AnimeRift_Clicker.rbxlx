						<Item class="Script" referent="RBXDBD80EAAEDE145B2AB7312CCA883E045">
							<Properties>
								<ProtectedString name="Source">-- 22/5/2018: So turns out, Baldi without a humanoid body is too skinny to move --
--DuruTeru
--[[

____________________________________________________________________________________________________________________

=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-	
____________________________________________________________________________________________________________________
