			task.wait(0.76)

			if
				not Hovering
				and not Clicking
				and not Destroyed
			then

				Tween(
					Scale,
					0.8,
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.InOut,
					{
						Scale = 1
					}
				)

				Tween(
					Button,
					0.8,
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.InOut,
					{
						Position = OriginalPosition
					}
				)
			end
		end
	end
