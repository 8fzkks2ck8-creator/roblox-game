	<Item class="ServerScriptService" referent="RBX980">
		<Properties>
			<bool name="LoadStringEnabled">false</bool>
			<BinaryString name="AttributesSerialize" />
			<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
			<bool name="DefinesCapabilities">false</bool>
			<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
			<string name="Name">ServerScriptService</string>
			<BinaryString name="SerializedOverrides" />
			<int64 name="SourceAssetId">-1</int64>
			<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
			<UniqueId name="UniqueId">636cc10f33c4f61b0afa722f000003d1</UniqueId>
		</Properties>
		<Item class="ModuleScript" referent="RBX986">
			<Properties>
				<Content name="LinkedSource"><null /></Content>
				<string name="ScriptGuid">{9A655715-BAE0-4F2B-8577-69B8D039072F}</string>
				<BinaryString name="AttributesSerialize" />
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">Profiles</string>
				<BinaryString name="SerializedOverrides" />
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">636cc10f33c4f61b0afa722f00001085</UniqueId>
			<ProtectedString name="Source">local Players=game:GetService("Players")
local DSS=game:GetService("DataStoreService")
local Run=game:GetService("RunService")
local Http=game:GetService("HttpService")
local C=require(game.ReplicatedStorage.AnimeRift.Config)
local memory=Run:IsStudio() and C.StudioMemory
-- An unpublished Studio place must never request a DataStore in memory mode.
local Store
if not memory then Store=DSS:GetDataStore(C.DataStore) end
local P={Cache={},Ready={},Busy={},Pending={},Closing={}}
local token=game.JobId..Http:GenerateGUID(false)
local function copy(x) if type(x)~="table" then return x end local t={} for k,v in pairs(x) do t[k]=copy(v) end return t end
local function fresh()
 local hero=C.Roll(C.Characters,false,false,Random.new())
 return {Coins=C.Economy.StartingCoins,Gems=0,Tickets=0,Boosted=0,Characters={[hero.Id]=1},Cosmetics={},Equipped=hero.Id,Aura="",Codes={},Receipts={},LuckUntil=0,WheelDay=-1,Wins=0,Strength=0,Rebirths=0}
end
function P.Load(player)
 local seed=fresh(); local result
 local ok=pcall(function()
 if memory then result=seed; return end
 result=Store:UpdateAsync("p"..player.UserId,function(old)
  local d=old or seed
  if d.Lock and d.Lock.Token~=token and (tonumber(d.Lock.Until) or 0)&gt;os.time() then return nil end
  d.Lock={Token=token,Until=os.time()+180}; return d
 end)
 end)
 if not ok or not result then player:Kick("Data is busy or unavailable. Please rejoin in a moment."); return false end
 -- Add missing fields without discarding existing progress on schema upgrades.
 for key,value in pairs(seed) do if result[key]==nil then result[key]=copy(value) end end
 result.Strength=math.clamp(result.Strength or 0,0,C.Training.MaxStrength)
 P.Pending[player]=0;P.Cache[player]=result; P.Ready[player]=true
 return true
end
function P.Strength(player)
 local d=P.Cache[player]
 return math.min(C.Training.MaxStrength,(d and d.Strength or 0)+(P.Pending[player] or 0))
end
function P.Train(player,amount)
 if not P.Ready[player] or P.Closing[player] then return 0 end
 local gain=math.min(amount,C.Training.MaxStrength-P.Strength(player))
 P.Pending[player]=(P.Pending[player] or 0)+gain
 return gain
end
-- Every economic mutation commits atomically. Receipt IDs and rewards share one write.
function P.Change(player,fn,finalizing)
 while P.Busy[player] do task.wait(0.05) end
 if not P.Ready[player] or (P.Closing[player] and not finalizing) then return false end
 P.Busy[player]=true
 local pending=P.Pending[player] or 0
 local function merge(d) if d.Rebirths==nil then d.Rebirths=0 end;d.Strength=math.min(C.Training.MaxStrength,(d.Strength or 0)+pending) end
 local result; local ok=pcall(function()
  if memory then result=copy(P.Cache[player]); merge(result);fn(result); P.Cache[player]=result; return end
  result=Store:UpdateAsync("p"..player.UserId,function(d)
   if not d or not d.Lock or d.Lock.Token~=token then return nil end
   merge(d);fn(d); d.Lock.Until=os.time()+180; return d
  end)
  if not result then error("Profile ownership lost") end
  P.Cache[player]=result
 end)
 if ok then P.Pending[player]=math.max(0,(P.Pending[player] or 0)-pending) end
 P.Busy[player]=nil
 if not ok then warn("Anime Rift profile transaction failed for",player.UserId); return false end
 return true,result
end
function P.Close(player)
 if P.Closing[player] then while P.Closing[player] do task.wait(.05) end;return end
 P.Closing[player]=true
 while P.Busy[player] do task.wait(0.05) end
 local flushed=true
 if P.Ready[player] then
  flushed=false
  for attempt=1,3 do
   if P.Change(player,function() end,true) then flushed=true;break end
   task.wait(attempt*.5)
  end
 end
 if not flushed then warn("Could not flush recent strength for "..player.UserId.."; leaving saved profile locked until its lease expires.") end
 P.Ready[player]=nil
 if not memory and flushed then
  pcall(function() Store:UpdateAsync("p"..player.UserId,function(d)
   if d and d.Lock and d.Lock.Token==token then d.Lock=nil; return d end
   return nil
  end) end)
 end
 P.Cache[player]=nil;P.Pending[player]=nil;P.Closing[player]=nil
end
task.spawn(function()
 while task.wait(15) do
  for player in pairs(P.Ready) do if not P.Closing[player] then task.spawn(function()
   if not P.Closing[player] and not P.Change(player,function() end) and player.Parent and not P.Closing[player] then player:Kick("Data connection lost. Rejoin to protect progress.") end
  end) end end
 end
end)
game:BindToClose(function()
 local n=0
 for player in pairs(P.Ready) do n=n+1; task.spawn(function() P.Close(player); n=n-1 end) end
 local untilTime=os.clock()+25
 while n&gt;0 and os.clock()&lt;untilTime do task.wait(0.1) end
end)
return P
</ProtectedString></Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX987">
			<Properties>
				<Content name="LinkedSource"><null /></Content>
				<string name="ScriptGuid">{9DFC1227-B53A-406B-922A-FBBBAB257C3C}</string>
				<BinaryString name="AttributesSerialize" />
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">World</string>
				<BinaryString name="SerializedOverrides" />
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">636cc10f33c4f61b0afa722f00001086</UniqueId>
			<ProtectedString name="Source">-- Rift Meadows: a new clicker garden with waterways, a training court and six service stations.
local W = {}
local Lighting = game:GetService("Lighting")
function W.Build()
 local layout = workspace:FindFirstChild("RiftLayout")
 local marker = layout and layout:FindFirstChild("LobbySpawn")
 W.Spawn = marker and marker.CFrame or CFrame.new(0, 5, 40)
 local old = workspace:FindFirstChild("RiftWorld"); if old then old:Destroy() end
 local world = Instance.new("Folder", workspace); world.Name = "RiftWorld"
 local lime = Color3.fromRGB(166, 233, 42)
 local green = Color3.fromRGB(137, 203, 35)
 local earth = Color3.fromRGB(184, 121, 98)
 local wood = Color3.fromRGB(165, 103, 75)
 local white = Color3.fromRGB(241, 242, 255)
 local lavender = Color3.fromRGB(160, 162, 248)
 local blue = Color3.fromRGB(80, 129, 228)
 local red = Color3.fromRGB(242, 45, 74)
 local gold = Color3.fromRGB(255, 220, 105)
 local function part(name, size, pos, color, material)
  local p = Instance.new("Part")
  p.Name = name; p.Size = size; p.Position = pos; p.Anchored = true
  p.Color = color; p.Material = material or Enum.Material.Plastic
  p.TopSurface = Enum.SurfaceType.Studs; p.BottomSurface = Enum.SurfaceType.Smooth
  p.FrontSurface = Enum.SurfaceType.Studs; p.BackSurface = Enum.SurfaceType.Studs
  p.LeftSurface = Enum.SurfaceType.Studs; p.RightSurface = Enum.SurfaceType.Studs
  p.Parent = world
  return p
 end
 local function decor(p)
  p.CanCollide = false; p.CanTouch = false; p.CanQuery = false
  return p
 end
 local function sign(text, pos, width, color)
  part("Sign frame", Vector3.new(width + 1.5, 5.5, .8), pos, lavender)
  part("Sign inset", Vector3.new(width, 4.2, 1), pos, blue)
  local anchor = decor(part("Wayfinding", Vector3.one, pos + Vector3.new(0, 0, 1), color))
  anchor.Transparency = 1
  local gui = Instance.new("BillboardGui", anchor); gui.Size = UDim2.fromOffset(width * 18, 70)
  gui.MaxDistance = 150; gui.LightInfluence = 0
  local label = Instance.new("TextLabel", gui); label.Size = UDim2.fromScale(1, 1)
  label.BackgroundTransparency = 1; label.Font = Enum.Font.FredokaOne
  label.Text = text; label.TextSize = 27; label.TextWrapped = true
  label.TextColor3 = color; label.TextStrokeTransparency = .15
 end
 local function tree(x, z, height)
  part("Studded trunk", Vector3.new(3, height, 3), Vector3.new(x, height / 2, z), wood)
  for layer = 0, 2 do
   local width = 13 - layer * 2.2
   local p = decor(part("Block canopy", Vector3.new(width, 4, width), Vector3.new(x, height + layer * 3, z), layer == 1 and lime or green))
   p.CFrame = p.CFrame * CFrame.Angles(0, math.rad(layer * 16), 0)
  end
 end
 local function fence(x, z, length)
  for dz = -length / 2, length / 2, 6 do
   part("Fence post", Vector3.new(.9, 3.5, .9), Vector3.new(x, 1.75, z + dz), wood)
  end
  for _, y in ipairs({1.15, 2.6}) do part("Fence rail", Vector3.new(.55, .6, length), Vector3.new(x, y, z), earth) end
 end
 local function lamp(pos)
  part("Lantern post", Vector3.new(.9, 9, .9), pos + Vector3.new(0, 4.5, 0), wood)
  part("Lantern base", Vector3.new(2.2, .4, 2.2), pos + Vector3.new(0, 9, 0), lavender)
  local glow = decor(part("Warm lantern", Vector3.new(1.4, 2.2, 1.4), pos + Vector3.new(0, 10.2, 0), gold, Enum.Material.Neon))
  part("Lantern roof", Vector3.new(2.4, .5, 2.4), pos + Vector3.new(0, 11.5, 0), lavender)
  local light = Instance.new("PointLight", glow); light.Color = gold; light.Range = 15; light.Brightness = .55
 end
 -- Broad paths and flush platforms leave the center of the avenue unobstructed.
 part("Garden island", Vector3.new(224, 13, 204), Vector3.new(0, -6.5, 0), earth)
 part("Studded grass", Vector3.new(224, 1, 204), Vector3.new(0, -.1, 0), lime)
 part("Avenue white border", Vector3.new(24, .5, 190), Vector3.new(0, .45, 0), white)
 part("Red avenue", Vector3.new(21, .6, 190), Vector3.new(0, .51, 0), red)
 part("Crossway border", Vector3.new(205, .4, 17), Vector3.new(0, .45, 0), white)
 part("Lavender crossway", Vector3.new(205, .5, 14), Vector3.new(0, .5, 0), lavender)
 -- Raised accents on the avenue make the classic stud look visible at a distance.
 -- Most surfaces use native studs instead of thousands of individual geometry parts.
 for z = -90, 90, 6 do
  for _, x in ipairs({-7, -3.5, 0, 3.5, 7}) do
   decor(part("Avenue stud", Vector3.new(1, .1, 1), Vector3.new(x, .86, z), Color3.fromRGB(220, 38, 67)))
  end
 end
 for _, x in ipairs({-18, 18}) do fence(x, 62, 42); fence(x, -35, 28) end
 for _, x in ipairs({-25, 25}) do for _, z in ipairs({-78, -10, 29, 83}) do lamp(Vector3.new(x, 0, z)) end end
 for _, x in ipairs({-98, 98}) do for _, z in ipairs({-83, -44, 8, 61, 88}) do tree(x, z, 16 + math.abs(z) % 5) end end
 for _, x in ipairs({-69, -40, 40, 69}) do tree(x, 85, 14); tree(x, -93, 15) end
 -- Stepped grassy cliffs enclose the plaza like the reference without hiding kiosks.
 for i = -3, 3 do
  local h = 17 + math.abs(i) * 3
  part("Back terrace", Vector3.new(34, h, 17), Vector3.new(i * 34, h / 2 - 4, -112), earth)
  part("Back terrace grass", Vector3.new(35, 1.5, 19), Vector3.new(i * 34, h - 3, -112), green)
 end
 for _, side in ipairs({-1, 1}) do
  for z = -84, 84, 42 do
   part("Side terrace", Vector3.new(14, 20, 40), Vector3.new(side * 120, 6, z), earth)
   part("Side terrace grass", Vector3.new(16, 1.5, 41), Vector3.new(side * 120, 16.8, z), green)
  end
 end
 -- Additional raised grass studs flank the avenue; they are cosmetic and noncolliding.
 for _,side in ipairs({-1,1}) do for x=22,38,4 do for z=-88,88,8 do
  decor(part("Raised grass stud",Vector3.new(.9,.14,.9),Vector3.new(side*x,.48,z),green))
 end end end
 -- Transparent boundaries cover the front edge as well as the cliff-backed edges.
 for _, x in ipairs({-112, 112}) do local p = part("Island boundary", Vector3.new(1, 80, 204), Vector3.new(x, 40, 0), white); p.Transparency = 1 end
 for _, z in ipairs({-102, 102}) do local p = part("Island boundary", Vector3.new(224, 80, 1), Vector3.new(0, 40, z), white); p.Transparency = 1 end
 local function kiosk(name, text, pos, color, action)
  part(name .. " platform trim", Vector3.new(30, .7, 23), pos, white)
  part(name .. " platform", Vector3.new(27, .8, 20), pos + Vector3.new(0, .15, 0), lavender)
  part(name .. " display pad", Vector3.new(10, 1, 9), pos + Vector3.new(0, .8, 0), color)
  for _, dx in ipairs({-12, 12}) do part("Kiosk signpost", Vector3.new(1.2, 11, 1.2), pos + Vector3.new(dx, 5.5, -7), lavender) end
  sign(text, pos + Vector3.new(0, 11, -7), 26, white)
  local orb = decor(part(name, Vector3.new(3.6, 3.6, 3.6), pos + Vector3.new(0, 4, 0), color, Enum.Material.Neon))
  orb.Shape = Enum.PartType.Ball; orb:SetAttribute("RiftFloat", true)
  local prompt = Instance.new("ProximityPrompt", orb)
  prompt.ActionText = "Open"; prompt.ObjectText = text; prompt.HoldDuration = 0
  prompt.MaxActivationDistance = 14; prompt.RequiresLineOfSight = false; prompt:SetAttribute("RiftAction", action)
 end
 kiosk("Summon", "SUMMON FIGHTERS", Vector3.new(-51, 1, -31), Color3.fromRGB(79, 218, 255), "Summon")
 kiosk("Cosmetics", "AURA GARDEN", Vector3.new(51, 1, -31), Color3.fromRGB(205, 122, 255), "Cosmetics")
 kiosk("Starter", "RIFT STORE", Vector3.new(-51, 1, 32), gold, "Shop")
 kiosk("Wheel", "DAILY WHEEL", Vector3.new(51, 1, 32), Color3.fromRGB(133, 245, 83), "Wheel")
 kiosk("Rebirth", "REBIRTH GATE", Vector3.new(0, 1, -78), Color3.fromRGB(255, 101, 158), "Rebirth")
 kiosk("Sell", "SELL YOUR POWER", Vector3.new(0, 1, 71), Color3.fromRGB(135, 240, 35), "Sell")
 -- A shallow stream, stepped bridges and a central fountain make a distinct new hub.
 for _,x in ipairs({-62,62}) do
  local water=decor(part("Meadow stream",Vector3.new(96,.25,12),Vector3.new(x,.62,14),Color3.fromRGB(76,211,255),Enum.Material.Glass));water.Transparency=.2
  for _,z in ipairs({7.5,20.5}) do part("Stream bank",Vector3.new(96,.3,.8),Vector3.new(x,.65,z),white) end
  part("Garden footbridge",Vector3.new(12,.6,16),Vector3.new(x,1,14),wood)
  for _,side in ipairs({-1,1}) do part("Bridge railing",Vector3.new(.5,2,16),Vector3.new(x+side*5.5,2,14),white) end
 end
 part("Training court border",Vector3.new(38,.3,28),Vector3.new(0,.82,40),white)
 part("Training court",Vector3.new(35,.35,25),Vector3.new(0,.9,40),Color3.fromRGB(255,111,139))
 part("Training court center",Vector3.new(16,.1,16),Vector3.new(0,1.1,40),Color3.fromRGB(255,212,76))
 sign("CLICKING COURT",Vector3.new(-30,9,45),18,white)
 part("Fountain plaza",Vector3.new(38,.3,25),Vector3.new(0,.87,-53),lavender)
 part("Fountain rim",Vector3.new(13,1.1,13),Vector3.new(0,1.3,-53),white)
 local pool=decor(part("Fountain water",Vector3.new(11,.25,11),Vector3.new(0,1.95,-53),Color3.fromRGB(76,211,255),Enum.Material.Glass));pool.Transparency=.25
 part("Fountain pedestal",Vector3.new(3,4,3),Vector3.new(0,3,-53),lavender)
 local jewel=decor(part("Rift fountain jewel",Vector3.new(3,3,3),Vector3.new(0,6,-53),Color3.fromRGB(102,241,255),Enum.Material.Neon));jewel:SetAttribute("RiftFloat",true)
 for _,x in ipairs({-32,32}) do for _,z in ipairs({-54,56}) do
  part("Flower planter",Vector3.new(9,1.2,5),Vector3.new(x,1,z),white)
  for j=1,3 do part("Block flower",Vector3.new(1.3,1.6,1.3),Vector3.new(x-4+j*2,2.4,z),j%2==0 and gold or Color3.fromRGB(255,105,180)) end
 end end
 for _, x in ipairs({-77, 77}) do
  for _, z in ipairs({-62, 0, 62}) do
   part("Garden display trim", Vector3.new(22, .6, 16), Vector3.new(x, .6, z), white)
   part("Garden display platform", Vector3.new(20, .7, 14), Vector3.new(x, .7, z), lavender)
   for j = 1, 3 do part("Little block bush", Vector3.new(3, 2 + j % 2, 3), Vector3.new(x - 4 + j * 2, 2, z), green) end
  end
 end
 -- Segmented neon rainbow, with a few soft cloud clusters above the rear cliffs.
 local rainbow = {Color3.fromRGB(255, 99, 162), Color3.fromRGB(255, 183, 103), Color3.fromRGB(255, 244, 134), Color3.fromRGB(131, 255, 157), Color3.fromRGB(119, 218, 255)}
 for band, color in ipairs(rainbow) do
  local radius = 31 - band * 1.6
  for step = 0, 23 do
   local angle = (step + .5) * math.pi / 24
   local p = decor(part("Rainbow arch", Vector3.new(4.2, 1.2, 2), Vector3.new(math.cos(angle) * radius, 15 + math.sin(angle) * radius, -99), color, Enum.Material.Neon))
   p.CFrame = CFrame.new(p.Position) * CFrame.Angles(0, 0, angle + math.pi / 2)
  end
 end
 for _, x in ipairs({-142, -78, 78, 142}) do
  for j = 1, 3 do
   local p = decor(part("Cloud puff", Vector3.new(23, 12, 15), Vector3.new(x + j * 9, 64 + j % 2 * 5, -130), white))
   p.Shape = Enum.PartType.Ball
  end
 end
 sign("RIFT MEADOWS", Vector3.new(0, 21, -100), 30, white)
 local spawn = Instance.new("SpawnLocation", world)
 spawn.Name = "SanctuarySpawn"; spawn.Size = Vector3.new(9, .4, 9)
 spawn.CFrame = W.Spawn * CFrame.new(0, -4, 0); spawn.Anchored = true; spawn.Neutral = true; spawn.Transparency = 1; spawn.Duration = 0
 Lighting.ClockTime = 13.5; Lighting.Brightness = 2.4
 Lighting.Ambient = Color3.fromRGB(151, 160, 193); Lighting.OutdoorAmbient = Color3.fromRGB(177, 193, 219)
 for _, name in ipairs({"RiftBloom", "RiftAtmosphere"}) do local effect = Lighting:FindFirstChild(name); if effect then effect:Destroy() end end
 local bloom = Instance.new("BloomEffect", Lighting); bloom.Name = "RiftBloom"; bloom.Intensity = .22; bloom.Size = 26; bloom.Threshold = 1.5
 local atmosphere = Instance.new("Atmosphere", Lighting); atmosphere.Name = "RiftAtmosphere"; atmosphere.Density = .19
 atmosphere.Color = Color3.fromRGB(184, 226, 255); atmosphere.Decay = Color3.fromRGB(117, 160, 240)
 if layout then for _, m in ipairs(layout:GetDescendants()) do if m:IsA("BasePart") then m.Transparency = 1; m.CanCollide = false; m.CanTouch = false; m.CanQuery = false end end end
 return W
end
return W
</ProtectedString></Properties>
		</Item>
		<Item class="Script" referent="RBX989">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null /></Content>
				<token name="RunContext">0</token>
				<string name="ScriptGuid">{574DD6FE-DA22-402B-9DF8-5F7FC2F7DBF7}</string>
				<BinaryString name="AttributesSerialize" />
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">Server</string>
				<BinaryString name="SerializedOverrides" />
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">636cc10f33c4f61b0afa722f00001088</UniqueId>
			<ProtectedString name="Source">local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local Market=game:GetService("MarketplaceService")
local Policy=game:GetService("PolicyService")
local Run=game:GetService("RunService")
local folder=RS:WaitForChild("AnimeRift")
local C=require(folder.Config)
local remote=Instance.new("RemoteFunction",folder); remote.Name="Request"
local event=Instance.new("RemoteEvent",folder); event.Name="Event"
folder:SetAttribute("ServerStatus","Starting")
remote.OnServerInvoke=function() return {Ok=false,Loading=true,Message="Server is starting..."} end
local function boot()
local P=require(script.Parent.Profiles)
local W=require(script.Parent.World).Build()
local A=require(script.Parent.Avatars)
local Clicker=require(script.Parent.Clicker)
local Admin=require(script.Parent.Admin)
local Rage=require(script.Parent.BrolySkill).new(C.BrolySkill,os.clock)
local policies,limits,working,training={},{},{},{}
local rng=Random.new()
local function send(p,kind,data) if p.Parent==Players then event:FireClient(p,kind,data) end end
local function allowed(p) return policies[p]==true or (Run:IsStudio() and C.StudioMemory) end
local function lucky(p,d) return allowed(p) and d.LuckUntil&gt;os.time() end
local function clickGain(p,d) return C.ClickGain(d.Equipped,d.Rebirths,d.Aura)*Rage:Multiplier(p,d) end
local function state(p)
 local d=P.Cache[p]; if not d then return nil end
 return {Strength=P.Strength(p),ClickGain=clickGain(p,d),BrolySkill=Rage:State(p,d),SellValue=P.Strength(p)*C.Clicker.SellRate,Rebirths=d.Rebirths,RebirthCost=C.RebirthCost(d.Rebirths),Coins=d.Coins,Gems=d.Gems,Tickets=d.Tickets,Boosted=d.Boosted,Characters=d.Characters,Cosmetics=d.Cosmetics,Equipped=d.Equipped,Aura=d.Aura,Wins=d.Wins,LuckUntil=d.LuckUntil,Lucky=lucky(p,d),PaidAllowed=allowed(p),WheelReady=d.WheelDay&lt;math.floor(os.time()/86400),ServerTime=os.time(),Studio=Run:IsStudio(),IsOwner=Admin.IsOwner(p),IsAdmin=Admin.Allowed(p)}
end
local function sync(p) send(p,"State",state(p)) end
local function edit(p,fn)
 local ok=P.Change(p,fn)
 if not ok then return false,"Could not save. Please try again." end
 sync(p); return true
end
A.Init(function(p) return P.Cache[p] end)
local function onCharacter(p,m)
 local root=m:WaitForChild("HumanoidRootPart",10); if not root or p.Character~=m or not P.Ready[p] then return end
 if not m:GetAttribute("RiftCharacterId") then m:PivotTo(W.Spawn) end
 task.wait(0.2); if p.Character~=m or not m.Parent then return end
 A.Decorate(p)
 if p.Character~=m then return end

end
local function join(p)
 -- Load free inventory independently of the external policy request.
 if not p.Parent then return end
 policies[p]=false
 if not P.Load(p) then return end
 if not p.Parent then P.Close(p); policies[p]=nil; return end
 p.CharacterAdded:Connect(function(m) onCharacter(p,m) end)
 p.CharacterAppearanceLoaded:Connect(function(character) if P.Ready[p] and p.Character==character then A.Decorate(p) end end)
 if p.Character then task.spawn(onCharacter,p,p.Character) end
 sync(p)
 if not Run:IsStudio() then task.spawn(function()
  local ok,info=pcall(function() return Policy:GetPolicyInfoForPlayerAsync(p) end)
  if not p.Parent or not P.Ready[p] then return end
  policies[p]=ok and type(info)=="table" and info.ArePaidRandomItemsRestricted==false
  sync(p)
 end) end
end
Players.PlayerAdded:Connect(join)
for _,p in ipairs(Players:GetPlayers()) do task.spawn(join,p) end
Players.PlayerRemoving:Connect(function(p) Rage:Clear(p);P.Close(p); policies[p]=nil; limits[p]=nil; working[p]=nil;training[p]=nil; Admin.Last[p.UserId]=nil end)
local function handle(p,action,arg)
 local d=P.Cache[p]
 if action=="State" then return {Ok=true,State=state(p)} end
 if P.Closing[p] then return {Ok=false,Message="Your progress is being saved."} end
 if action=="Admin" then return Admin.Execute(p,arg,P,sync,send) end
 if action=="BrolySkill" then
  local result=Rage:Activate(p,d)
  if result.Ok then send(p,"BrolySkillStart",result.State);sync(p) end
  return result
 end
 if action=="Train" then
  local now=os.clock()
  if now-(training[p] or -math.huge)&lt;C.Training.Interval then return {Ok=false} end
  local h=p.Character and p.Character:FindFirstChildOfClass("Humanoid")
  if not h or h.Health&lt;=0 then return {Ok=false,Message="Wait for your character to spawn."} end
  if Rage:State(p,d).Charging then return {Ok=false,Message="Legendary Rage is still charging."} end
  training[p]=now
  local gain=P.Train(p,clickGain(p,d))
  send(p,"Training",{Gain=gain,Strength=P.Strength(p),ClickGain=clickGain(p,d),BrolySkill=Rage:State(p,d),SellValue=P.Strength(p)*C.Clicker.SellRate})
  return {Ok=true}
 end
 if action=="Home" then
  local character=p.Character;local humanoid=character and character:FindFirstChildOfClass("Humanoid")
  if not character or not humanoid or humanoid.Health&lt;=0 then return {Ok=false,Message="Wait for your character to spawn."} end
  character:PivotTo(W.Spawn);return {Ok=true,Message="Returned to the clicking court."}
 end
 if Clicker.Actions[action] then
  local result
  local ok,err=edit(p,function(data) result=Clicker.Apply(action,data,arg) end)
  if not ok then return {Ok=false,Message=err} end
  if result.Ok and (action=="EquipBest" or action=="UnequipAll") then A.Decorate(p) end
  if result.Ok and (action=="Sell" or action=="Rebirth") then send(p,"ClickerReward",{Kind=action,Amount=result.Amount or 0}) end
  return result
 end
 if action=="PreviewProduct" then
  if not Run:IsStudio() or not C.StudioMemory then return {Ok=false,Message="Pack previews only work in Studio test mode."} end
  local product=C.Products[arg]
  if not product then return {Ok=false,Message="Unknown product."} end
  local ok,err=edit(p,function(data)
   C.GrantProduct(data,product)
  end)
  if ok and product.Character then send(p,"Reveal",{Kind="Character",Id=product.Character}) end
  return {Ok=ok,Message=err or "STUDIO PREVIEW • Test rewards added. No Robux charged; resets when you stop."}
 end
 if action=="Purchase" then
  local product=C.Products[arg]
  if not product then return {Ok=false,Message="Unknown product."} end
  if not allowed(p) then return {Ok=false,Message="Paid random rewards are unavailable for this account. Sell power and rebirth to earn coins and gems."} end
  if Run:IsStudio() or product.Id==0 then return {Ok=false,Message="Purchase not enabled. Configure product IDs and test in a published experience."} end
  return {Ok=true,ProductId=product.Id}
 end
 if action=="Spin" then
  if arg~="Coins" and arg~="Ticket" and arg~="Boosted" then return {Ok=false,Message="Invalid spin."} end
  if arg~="Coins" and not allowed(p) then return {Ok=false,Message="Ticket rolls unavailable. Use earned coins for a free-path roll."} end
  local item=C.Roll(C.Characters,arg=="Boosted",lucky(p,d),rng); local message; local granted=false
  local ok,err=edit(p,function(data)
   granted=false
   if arg=="Coins" then if data.Coins&lt;C.SpinCost then message="Need "..C.SpinCost.." coins."; return end; data.Coins=data.Coins-C.SpinCost
   elseif arg=="Ticket" then if data.Tickets&lt;1 then message="No spin tickets."; return end; data.Tickets=data.Tickets-1
   else if data.Boosted&lt;1 then message="No boosted tickets."; return end; data.Boosted=data.Boosted-1 end
   data.Characters[item.Id]=(data.Characters[item.Id] or 0)+1
   -- Duplicates remain in inventory and award 50 free coins.
   if data.Characters[item.Id]&gt;1 then data.Coins=data.Coins+C.Economy.CharacterDuplicate end
   granted=true
  end)
  if not ok or not granted then return {Ok=false,Message=err or message} end
  send(p,"Reveal",{Kind="Character",Id=item.Id}); return {Ok=true}
 elseif action=="Cosmetic" then
  if arg~="Standard" and arg~="Boosted" then return {Ok=false,Message="Invalid cosmetic roll."} end
  local cost=arg=="Boosted" and C.Economy.CosmeticBoosted or C.Economy.CosmeticStandard; local item=C.Roll(C.Cosmetics,arg=="Boosted",lucky(p,d),rng); local granted=false
  local ok,err=edit(p,function(data)
   granted=false; if data.Gems&lt;cost then return end
   data.Gems=data.Gems-cost; data.Cosmetics[item.Id]=(data.Cosmetics[item.Id] or 0)+1
   if data.Cosmetics[item.Id]&gt;1 then data.Gems=data.Gems+C.Economy.CosmeticDuplicate end
   granted=true
  end)
  if not ok or not granted then return {Ok=false,Message=err or ("Need "..cost.." gems.")} end
  send(p,"Reveal",{Kind="Cosmetic",Id=item.Id}); return {Ok=true}
 elseif action=="Equip" then
  if not C.Find(C.Characters,arg) or not d.Characters[arg] then return {Ok=false,Message="Character not owned."} end
  local ok,err=edit(p,function(data) data.Equipped=arg end); if ok then A.Decorate(p) end
  return {Ok=ok,Message=err or "Character equipped!"}
 elseif action=="Aura" then
  if arg~="" and (not C.Find(C.Cosmetics,arg) or not d.Cosmetics[arg]) then return {Ok=false,Message="Cosmetic not owned."} end
  local ok,err=edit(p,function(data) data.Aura=arg end); if ok then A.Decorate(p) end
  return {Ok=ok,Message=err or "Cosmetic equipped!"}
 elseif action=="Code" then
  local code=string.upper((arg or ""):gsub("%s+","")); local gift=C.Codes[code]
  if not gift then return {Ok=false,Message="That code does not exist."} end
  local redeemed=false
  local ok,err=edit(p,function(data)
   redeemed=false; if data.Codes[code] then return end
   data.Codes[code]=true; data.Coins=data.Coins+(gift.Coins or 0); data.Gems=data.Gems+(gift.Gems or 0); redeemed=true
  end)
  return {Ok=ok and redeemed,Message=err or (redeemed and ("REDEEMED! "..code.." • +"..(gift.Coins or gift.Gems)..(gift.Coins and " coins" or " gems")) or "Code already redeemed.")}
 elseif action=="Wheel" then
  local number=rng:NextNumber(0,100); local total=0; local index=1
  for i,v in ipairs(C.Wheel) do total=total+v.Weight; if number&lt;total then index=i; break end end
  local prize=C.Wheel[index]; local granted=false
  local ok,err=edit(p,function(data)
   granted=false; local day=math.floor(os.time()/86400); if data.WheelDay&gt;=day then return end
   data.WheelDay=day; data.Coins=data.Coins+(prize.Coins or 0); data.Gems=data.Gems+(prize.Gems or 0); data.Tickets=data.Tickets+(prize.Tickets or 0); granted=true
  end)
  if not ok or not granted then return {Ok=false,Message=err or "Come back after the next 00:00 UTC reset."} end
  local slots={};for slot,prizeIndex in ipairs(C.WheelLayout()) do if prizeIndex==index then table.insert(slots,slot) end end
  send(p,"WheelResult",{Index=index,Slot=slots[rng:NextInteger(1,#slots)],Name=prize.Name}); return {Ok=true}
 end
 return {Ok=false,Message="Unknown action."}
end
remote.OnServerInvoke=function(p,action,arg)
 if type(action)~="string" or (arg~=nil and type(arg)~="string") or (arg and #arg&gt;80) then return {Ok=false} end
 if not P.Ready[p] then return {Ok=false,Message="Loading your inventory..."} end
 local now=os.clock(); local l=limits[p] or {At=now,Count=0}; limits[p]=l
 if now-l.At&gt;=1 then l.At=now; l.Count=0 end
 l.Count=l.Count+1; if l.Count&gt;15 then return {Ok=false} end
 if working[p] then return {Ok=false,Message="One moment..."} end
 local ownsWork=true
 if ownsWork then working[p]=true end
 local ok,result=pcall(handle,p,action,arg)
 if ownsWork then working[p]=nil end
 if not ok then warn("Anime Rift action failed:",result); return {Ok=false,Message="Action unavailable. Try again."} end
 return result
end
Market.ProcessReceipt=function(receipt)
 local p=Players:GetPlayerByUserId(receipt.PlayerId)
 if not p or not P.Ready[p] then return Enum.ProductPurchaseDecision.NotProcessedYet end
 local product
 for _,v in pairs(C.Products) do if v.Id&gt;0 and v.Id==receipt.ProductId then product=v; break end end
 if not product then return Enum.ProductPurchaseDecision.NotProcessedYet end
 local newGrant=false
 local ok=P.Change(p,function(data)
  newGrant=false
  if data.Receipts[receipt.PurchaseId] then return end
  C.GrantProduct(data,product)
  data.Receipts[receipt.PurchaseId]=true;newGrant=true
 end)
 if not ok then return Enum.ProductPurchaseDecision.NotProcessedYet end
 sync(p);if newGrant and product.Character then send(p,"Reveal",{Kind="Character",Id=product.Character}) end
 send(p,"Toast","Purchase delivered to your inventory!")
 return Enum.ProductPurchaseDecision.PurchaseGranted
end

-- Handle kiosk prompts on the server; only the triggering player's menu opens.
game:GetService("ProximityPromptService").PromptTriggered:Connect(function(prompt,p)
 local world=workspace:FindFirstChild("RiftWorld")
 if not world or not prompt:IsDescendantOf(world) then return end
 local name=prompt:GetAttribute("RiftAction")
 if P.Ready[p] and (name=="Shop" or name=="Summon" or name=="Cosmetics" or name=="Wheel" or name=="Sell" or name=="Rebirth") then
  send(p,"OpenMenu",name)
 end
end)
folder:SetAttribute("ServerStatus","Ready")
end
local ok,err=xpcall(boot,debug.traceback)
if not ok then
 warn("[Anime Rift startup] "..tostring(err))
 folder:SetAttribute("ServerStatus","Error")
 folder:SetAttribute("StartupError",tostring(err):sub(1,700))
 remote.OnServerInvoke=function() return {Ok=false,Message="Server startup failed. See the red error in Studio Output."} end
end
</ProtectedString></Properties>
		</Item>
		<Item class="ModuleScript" referent="RIFT_CUSTOM_3289">
			<Properties>
				<Content name="LinkedSource"><null /></Content>
				<string name="ScriptGuid">{CE39021E-BAF8-4E5F-8B51-588B2FC5A3F7}</string>
				<BinaryString name="AttributesSerialize" />
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">Admin</string>
				<BinaryString name="SerializedOverrides" />
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">636cc10f33c4f61b0afa722f0000108a</UniqueId>
			<ProtectedString name="Source">local Players=game:GetService("Players")
local Run=game:GetService("RunService")
local C=require(game.ReplicatedStorage.AnimeRift.Config)
local A={Last={}}
local rng=Random.new()
function A.OwnerId()
 local shared=game.ReplicatedStorage.AnimeRift
 local settings=shared.FindFirstChild and shared:FindFirstChild("AdminSettings")
 local entry=settings and settings:FindFirstChild("OwnerUserId")
 local configured=tonumber(entry and entry.Value) or 0
 if configured&lt;=0 then configured=tonumber(C.Admin.OwnerUserId) or 0 end
 if configured&gt;0 then return math.floor(configured) end
 if game.CreatorType==Enum.CreatorType.User then return tonumber(game.CreatorId) or 0 end
 return 0
end
function A.IsOwner(p)
 local owner=A.OwnerId()
 return owner&gt;0 and p.UserId==owner
end
function A.Allowed(p)
 if A.IsOwner(p) then return true end
 if Run:IsStudio() and C.Admin.StudioEnabled then return true end
 for _,id in ipairs(C.Admin.UserIds or {}) do if p.UserId==tonumber(id) then return true end end
 return false
end
function A.Execute(p,command,profiles,sync,send)
 if type(command)~="string" then return {Ok=false,Message="Enter a character ID, for example give marlon."} end
 command=command:lower():match("^%s*(.-)%s*$")
 if type(command)=="string" and command:match("^give%s+") then
  if not A.IsOwner(p) then return {Ok=false,Message="Owner access is not configured for this account. Stop Play, then set ReplicatedStorage &gt; AnimeRift &gt; AdminSettings &gt; OwnerUserId to your Roblox user ID ("..p.UserId..")."} end
  local id=command:match("^give%s+([%w_]+)%s*$")
  local hero=id and C.Find(C.Characters,id:lower())
  if not hero then return {Ok=false,Message="Use give character_id, for example give marlon."} end
  local ok=profiles.Change(p,function(d) d.Characters[hero.Id]=(d.Characters[hero.Id] or 0)+1 end)
  if ok then sync(p);send(p,"Reveal",{Kind="Character",Id=hero.Id}) end
  return {Ok=ok,Message=ok and ("Granted "..hero.Name.." to your inventory.") or "Grant could not save."}
 end
 if not A.Allowed(p) then return {Ok=false,Message="Admin access denied."} end
 local valid={random=true,coins=true,gems=true,confetti=true,disco=true,resetwheel=true}
 if not valid[command] then return {Ok=false,Message="Unknown admin command."} end
 local now=os.clock()
 if A.Last[p.UserId] and now-A.Last[p.UserId]&lt;C.Admin.Cooldown then return {Ok=false,Message="Wait a few seconds before the next event."} end
 A.Last[p.UserId]=now
 if command=="random" then local pool={"coins","gems","confetti","disco"};command=pool[rng:NextInteger(1,#pool)] end
 if command=="resetwheel" then
  local ok=profiles.Change(p,function(d) d.WheelDay=-1 end)
  if ok then sync(p) end
  return {Ok=ok,Message=ok and "Your daily wheel is ready again." or "Could not save wheel reset."}
 end
 local delivered,failed=0,0
 for _,target in ipairs(Players:GetPlayers()) do
  if profiles.Ready[target] then
   local ok=true
   if command=="coins" then ok=profiles.Change(target,function(d) d.Coins=d.Coins+C.Admin.CoinGift end)
   elseif command=="gems" then ok=profiles.Change(target,function(d) d.Gems=d.Gems+C.Admin.GemGift end) end
   if ok then
    delivered=delivered+1;sync(target)
    local text=command=="coins" and ("COIN SHOWER! +"..C.Admin.CoinGift.." coins") or command=="gems" and ("GEM PARTY! +"..C.Admin.GemGift.." gems") or command=="disco" and "RIFT DISCO!" or "CONFETTI PARTY!"
    send(target,"AdminEvent",{Kind=command,Text=text,Duration=C.Admin.Duration})
   else failed=failed+1 end
  end
 end
 return {Ok=true,Message="Event: "..command.." • "..delivered.." players"..(failed&gt;0 and (" • "..failed.." save failures") or "")}
end
return A
</ProtectedString></Properties>
		</Item>
	<Item class="ModuleScript" referent="RBX_RIFT_SERVER_Avatars"><Properties><string name="Name">Avatars</string><ProtectedString name="Source">-- Fighter outfits and safe rig swaps; no combat behavior.
local C=require(game.ReplicatedStorage.AnimeRift.Config)
local Effects=require(game.ReplicatedStorage.AnimeRift.Effects)
local Details=require(game.ReplicatedStorage.AnimeRift.OutfitDetails)
local RigRepair=require(game.ReplicatedStorage.AnimeRift.RigRepair)
local A={}
local GetData
local function model(p) return p.Character end
local function root(p) local m=model(p);return m and m:FindFirstChild("HumanoidRootPart") end
function A.Init(getData) GetData=getData end
local function decorate(p)
 local m=model(p); if not m then return end
 local old=m:FindFirstChild("RiftAura"); if old then old:Destroy() end
 local d=GetData(p); if not d then return end
 local h=C.Find(C.Characters,d.Equipped)
 if not h then
  m:SetAttribute("RiftIdleId",nil)
  for _,name in ipairs({"RiftOutline","RiftOutfit"}) do local old=m:FindFirstChild(name);if old then old:Destroy() end end
  local root=m:FindFirstChild("HumanoidRootPart");local tag=root and root:FindFirstChild("HeroTag");if tag then tag:Destroy() end
  if m:GetAttribute("RiftStyled") or m:GetAttribute("RiftCharacterId") then p:LoadCharacterAsync() end
  return
 end
 m:SetAttribute("RiftStyled",true)
 local a=C.Find(C.Cosmetics,d.Aura)
 local assets=game.ReplicatedStorage.AnimeRift:FindFirstChild("Assets")
 local templates=assets and assets:FindFirstChild("CharacterModels")
 local custom=templates and templates:FindFirstChild(h.Id)
 if custom and not custom:IsA("Model") then custom=nil end
 if m:GetAttribute("RiftCharacterId") and not custom and p:IsA("Player") then p:LoadCharacterAsync();return end
 local usingCustom=m:GetAttribute("RiftCharacterId")==h.Id
 if custom and not usingCustom then
  local replacement,reason=RigRepair.Prepare(custom)
  if replacement then
   replacement.Name=p.Name;replacement:SetAttribute("RiftCharacterId",h.Id);replacement:SetAttribute("RiftIdleId",h.Id)
   local animate=m:FindFirstChild("Animate")
   if animate and animate:IsA("LocalScript") then animate:Clone().Parent=replacement end
   replacement.Parent=workspace;replacement:PivotTo(m:GetPivot())
   p.Character=replacement;m:Destroy();return
  end
  warn("Could not prepare "..h.Id..": "..tostring(reason).."; using the built-in outfit.")
 end
 if not usingCustom then
 local outfit=C.Outfits[h.Id] or C.Outfits.yamcha
 local oldOutfit=m:FindFirstChild("RiftOutfit"); if oldOutfit then oldOutfit:Destroy() end
 for _,v in ipairs(m:GetChildren()) do if v:IsA("Accessory") or v:IsA("Shirt") or v:IsA("Pants") or v:IsA("ShirtGraphic") or v:IsA("BodyColors") then v:Destroy() end end
 local colors=Instance.new("BodyColors",m)
 local skin=Color3.fromRGB(table.unpack(outfit.Skin)); local cloth=Color3.fromRGB(table.unpack(outfit.Cloth))
 colors.HeadColor3=skin; colors.LeftArmColor3=skin; colors.RightArmColor3=skin
 local legs=outfit.Legs and Color3.fromRGB(table.unpack(outfit.Legs)) or cloth
 colors.TorsoColor3=cloth; colors.LeftLegColor3=legs; colors.RightLegColor3=legs
 local hair=Instance.new("Folder",m);hair.Name="RiftOutfit"
 local head=m:FindFirstChild("Head")
 if head and not outfit.Bald and not outfit.Hat then
  for i=-2,2 do
   local spike=Instance.new("WedgePart"); spike.Name="Hair tuft"; spike.Size=Vector3.new(0.45,0.7+math.abs(i)*0.12,0.9); spike.Color=Color3.fromRGB(table.unpack(outfit.Hair)); spike.CanCollide=false; spike.CanTouch=false; spike.CanQuery=false; spike.Massless=true; spike.CFrame=head.CFrame*CFrame.new(i*0.32,0.6,0.1)*CFrame.Angles(0,0,-i*0.16); spike.Parent=hair
   local weld=Instance.new("WeldConstraint",spike); weld.Part0=head; weld.Part1=spike
  end
 end
 Details.Apply(m,outfit,hair,false)
 end
 m:SetAttribute("RiftIdleId",h.Id)
 for _,part in ipairs(m:GetChildren()) do if part:IsA("Part") then part.TopSurface=Enum.SurfaceType.Studs;part.BottomSurface=Enum.SurfaceType.Studs;part.FrontSurface=Enum.SurfaceType.Studs;part.BackSurface=Enum.SurfaceType.Studs end end
 Effects.ApplyAnimations(m,h.Id)
 local highlight=m:FindFirstChild("RiftOutline") or Instance.new("Highlight"); highlight.Name="RiftOutline"; highlight.FillTransparency=1; highlight.OutlineColor=h.Color; highlight.OutlineTransparency=0.3; highlight.Parent=m
 local r=root(p); if not r then return end
 local oldTag=r:FindFirstChild("HeroTag"); if oldTag then oldTag:Destroy() end
 local tag=Instance.new("BillboardGui",r); tag.Name="HeroTag"; tag.Size=UDim2.fromOffset(240,35); tag.StudsOffset=Vector3.new(0,3.5,0); tag.MaxDistance=80
 local label=Instance.new("TextLabel",tag); label.Size=UDim2.fromScale(1,1); label.BackgroundTransparency=1; label.Text=h.Name; label.TextColor3=h.Color; label.Font=Enum.Font.GothamBold; label.TextSize=14; label.TextStrokeTransparency=0.3
 if a then
  local folder=Instance.new("Folder",m); folder.Name="RiftAura"
  for i=1,a.Tier+2 do
   local angle=i*math.pi*2/(a.Tier+2)
   local orb=Instance.new("Part"); orb.Name="Aura stud"; orb.Shape=Enum.PartType.Ball; orb.Size=Vector3.new(0.45,0.45,0.45); orb.Material=Enum.Material.Neon; orb.Color=a.Color; orb.CanCollide=false; orb.CanTouch=false; orb.CanQuery=false; orb.Massless=true; orb.CFrame=r.CFrame*CFrame.new(math.cos(angle)*2,1,math.sin(angle)*2); orb.Parent=folder
   local weld=Instance.new("WeldConstraint",orb); weld.Part0=r; weld.Part1=orb
  end
 end
end
-- AppearanceLoaded and CharacterAdded may arrive together while a rig swaps.
local decorating={}
function A.Decorate(p)
 if decorating[p] then return end
 decorating[p]=true
 local ok,err=xpcall(function() decorate(p) end,debug.traceback)
 decorating[p]=nil
 if not ok then warn("Character decoration failed: "..tostring(err)) end
end
return A
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_RIFT_SERVER_Clicker"><Properties><string name="Name">Clicker</string><ProtectedString name="Source">-- All economy mutations run inside Profiles.Change/UpdateAsync on the server.
local C=require(game.ReplicatedStorage.AnimeRift.Config)
local K={Actions={Sell=true,Rebirth=true,EquipBest=true,UnequipAll=true,RecycleDuplicates=true}}
function K.Apply(action,d)
 if action=="Sell" then
  local power=math.max(0,math.floor(d.Strength or 0))
  if power==0 then return {Ok=false,Message="Click to build power before selling."} end
  local coins=power*C.Clicker.SellRate
  d.Strength=0;d.Coins+=coins
  return {Ok=true,Amount=coins,Message="Sold "..power.." power for "..coins.." coins!"}
 elseif action=="Rebirth" then
  local rebirths=d.Rebirths or 0
  if rebirths&gt;=C.Clicker.MaxRebirths then return {Ok=false,Message="Maximum rebirths reached."} end
  local cost=C.RebirthCost(rebirths)
  if d.Coins&lt;cost then return {Ok=false,Message="You need "..cost.." coins to rebirth."} end
  d.Coins=0;d.Strength=0;d.Rebirths=rebirths+1;d.Gems+=C.Clicker.RebirthGems
  return {Ok=true,Amount=C.Clicker.RebirthGems,Message="Rebirth complete! +"..C.Clicker.RebirthGems.." gems and a permanent power bonus."}
 elseif action=="EquipBest" then
  local best
  for _,hero in ipairs(C.Characters) do
   if (d.Characters[hero.Id] or 0)&gt;0 and (not best or C.ClickGain(hero.Id)&gt;C.ClickGain(best.Id)) then best=hero end
  end
  if not best then return {Ok=false,Message="Summon a fighter first."} end
  d.Equipped=best.Id
  return {Ok=true,Message="Equipped "..best.Name.."!"}
 elseif action=="UnequipAll" then
  d.Equipped="";d.Aura=""
  return {Ok=true,Message="Fighter and aura unequipped. Base clicking stays available."}
 elseif action=="RecycleDuplicates" then
  local removed=0
  for id,count in pairs(d.Characters) do
   local extra=math.max(0,math.floor(count)-1)
   if extra&gt;0 then d.Characters[id]=1;removed+=extra end
  end
  if removed==0 then return {Ok=false,Message="No duplicate fighters to recycle."} end
  local coins=removed*C.Clicker.RecycleCoins;d.Coins+=coins
  return {Ok=true,Amount=coins,Message="Recycled "..removed.." extra copies for "..coins.." coins. One of every fighter was kept."}
 end
 return {Ok=false,Message="Unknown clicker action."}
end
return K
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_RIFT_SERVER_BrolySkill"><Properties><string name="Name">BrolySkill</string><ProtectedString name="Source">-- Session-only server authority for Legendary Rage. Visuals never grant the bonus.
local S={}
function S.new(config,clock)
 clock=clock or os.clock
 local slots={}
 local self={}
 local function stop(record)
  record.Cancelled=true
  for _,connection in ipairs(record.Connections) do connection:Disconnect() end
  record.Connections={};record.Character=nil
 end
 local function eligible(player,data)
  if not data or data.Equipped~="broly" or (data.Characters.broly or 0)&lt;1 then return false end
  local character=player.Character
  local h=character and character:FindFirstChildOfClass("Humanoid")
  return h~=nil and h.Health&gt;0
 end
 function self:State(player,data)
  local now=clock();local record=slots[player]
  local canUse=eligible(player,data)
  if record and not record.Cancelled then
   if not canUse or player.Character~=record.Character or now&gt;=record.BuffEnd then stop(record) end
  end
  if record and now&gt;=record.ReadyAt then
   if not record.Cancelled then stop(record) end
   slots[player]=nil;record=nil
  end
  local live=record and not record.Cancelled
  local charging=live and now&lt;record.ChargeEnd or false
  local active=live and now&gt;=record.ChargeEnd and now&lt;record.BuffEnd or false
  local cooldown=record and math.max(0,record.ReadyAt-now) or 0
  return {
   Available=canUse and cooldown&lt;=0,Eligible=canUse,
   Charging=charging,Active=active,
   Multiplier=active and config.Multiplier or 1,
   ChargeRemaining=charging and math.max(0,record.ChargeEnd-now) or 0,
   ActiveRemaining=active and math.max(0,record.BuffEnd-now) or 0,
   CooldownRemaining=cooldown,
  }
 end
 function self:Activate(player,data)
  local current=self:State(player,data)
  if not current.Eligible then return {Ok=false,Message="Equip an owned Broly and wait for your character to spawn.",State=current} end
  if not current.Available then return {Ok=false,Message="Legendary Rage is on cooldown.",State=current} end
  local now=clock();local character=player.Character
  local record={Character=character,ChargeEnd=now+config.Windup,BuffEnd=now+config.Windup+config.Duration,ReadyAt=now+config.Cooldown,Connections={},Cancelled=false}
  slots[player]=record
  local h=character:FindFirstChildOfClass("Humanoid")
  if h.Died and h.Died.Connect then table.insert(record.Connections,h.Died:Connect(function() stop(record) end)) end
  if player.GetPropertyChangedSignal then
   table.insert(record.Connections,player:GetPropertyChangedSignal("Character"):Connect(function()
    if player.Character~=record.Character then stop(record) end
   end))
  end
  return {Ok=true,Message="Legendary Rage is charging!",State=self:State(player,data)}
 end
 function self:Multiplier(player,data) return self:State(player,data).Multiplier end
 function self:Clear(player)
  local record=slots[player];if record then stop(record) end
  slots[player]=nil
 end
 return self
end
return S
</ProtectedString></Properties></Item></Item>
