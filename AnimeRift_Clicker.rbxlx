		end

		Tween(
			Scale,
			0.28,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out,
			{
				Scale =
					Hovering
					and 1.052
					or 1.016
			}
		)

		Tween(
			Button,
			0.28,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out,
			{
				Position =
					Hovering
					and GetHoverPosition()
					or OriginalPosition,

				Rotation =
					Hovering
					and OriginalRotation - 0.3
					or OriginalRotation
			}
		)
	end)

	task.delay(0.34, function()
		if Destroyed then
			return
		end

		Tween(
			Scale,
			0.32,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.Out,
			{
				Scale =
					Hovering
					and HOVER_SCALE
					or 1
			}
		)

		Tween(
			Button,
			0.32,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.Out,
			{
				Position =
					Hovering
					and GetHoverPosition()
					or OriginalPosition,

				Rotation =
					Hovering
					and OriginalRotation - 0.4
					or OriginalRotation
			}
		)
	end)

	task.delay(0.58, function()
		Clicking = false
	end)
end

Button.MouseEnter:Connect(HoverEnter)
Button.MouseLeave:Connect(HoverLeave)
Button.Activated:Connect(ClickAnimation)

Button.AncestryChanged:Connect(function()
	if not Button:IsDescendantOf(game) then
		Destroyed = true
	end
end)

task.spawn(function()
	while Button.Parent and not Destroyed do

		task.wait(
			math.random(65, 100) / 10
		)

		if
			not Hovering
			and not Clicking
			and not Destroyed
		then

			PlaySound(IdleSound)

			Tween(
				Scale,
				0.75,
				Enum.EasingStyle.Sine,
				Enum.EasingDirection.InOut,
				{
					Scale = 1.01
				}
			)

			Tween(
				Button,
				0.75,
				Enum.EasingStyle.Sine,
				Enum.EasingDirection.InOut,
				{
					Position = UDim2.new(
						OriginalPosition.X.Scale,
						OriginalPosition.X.Offset,
						OriginalPosition.Y.Scale,
						OriginalPosition.Y.Offset - 1
					)
				}
			)

			task.wait(0.76)

			if
				not Hovering
				and not Clicking
				and not Destroyed
			then

				Tween(
					Scale,
					0.8,
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.InOut,
					{
						Scale = 1
					}
				)

				Tween(
					Button,
					0.8,
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.InOut,
					{
						Position = OriginalPosition
					}
				)
			end
		end
	end
end)</ProtectedString>
